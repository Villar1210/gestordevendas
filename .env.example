# Ambiente
NODE_ENV=development
PORT=3333

# Seguranca da API - gere uma chave longa e aleatoria em producao
JWT_SECRET=troque_esta_chave_por_uma_bem_longa_e_aleatoria
JWT_EXPIRES_IN=1d

# PostgreSQL + Prisma (nomes batem com o docker-compose.yml)
DATABASE_URL="postgresql://crm_admin:crm_password_2026@localhost:5432/crm_core_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB
MONGO_URI="mongodb://crm_mongo_admin:crm_mongo_password@localhost:27017/crm_atendimento_db?authSource=admin"

# Frontend (para CORS)
FRONTEND_URL="http://localhost:3000"
