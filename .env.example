# Ambiente
NODE_ENV=development
PORT=3333

# Seguranca da API - gere uma chave longa e aleatoria em producao
JWT_SECRET=troque_esta_chave_por_uma_bem_longa_e_aleatoria
JWT_EXPIRES_IN=1d

# PostgreSQL + Prisma (nomes batem com o docker-compose.yml)
DATABASE_URL="postgresql://crm_admin:crm_password_2026@localhost:5432/crm_core_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB
MONGO_URI="mongodb://crm_mongo_admin:crm_mongo_password@localhost:27017/crm_atendimento_db?authSource=admin"

# Frontend (para CORS)
FRONTEND_URL="http://localhost:3000"

# VIVI - assistente SDR de IA via WhatsApp (Anthropic)
ANTHROPIC_API_KEY=

# Modulo RH - cadastro publico multi-perfil (Cliente/Corretor/Parceiro).
# Tenant fixo para o qual os cadastros publicos (POST /rh/cadastro-publico)
# sao direcionados - hoje so suportamos 1 imobiliaria se cadastrando por
# este fluxo. Preencha com o id (uuid) do Tenant real antes de usar essa rota.
PUBLIC_SIGNUP_TENANT_ID=

# Modulo E-doc (assinatura eletronica) - quantos dias o link de assinatura
# de cada destinatario fica valido apos o envelope ser enviado.
SIGNATURE_TOKEN_EXPIRE_DAYS=7

# Modulo E-doc (Fatia 4) - caminho do executavel do LibreOffice, usado para
# converter documentos Word/Excel para PDF antes de criar o envelope. Se
# vazio, usa um fallback por sistema operacional (Windows:
# "C:\Program Files\LibreOffice\program\soffice.exe"; Linux/producao:
# "soffice", esperado no PATH apos "apt install libreoffice"). So precisa
# preencher se o LibreOffice estiver instalado em um local nao padrao.
LIBREOFFICE_PATH=

# Modulo Redes Sociais - conexao OAuth com Paginas do Facebook e contas do
# Instagram Business vinculadas, via App "Gestor de vendas" no Meta for
# Developers - App tipo Empresa, usa o fluxo "Facebook Login for Business"
# (nao o Login do Facebook classico - ver META_LOGIN_CONFIG_ID abaixo).
# META_APP_ID nao e segredo (id publico do App) - preenchido direto abaixo.
# META_APP_SECRET e sensivel, NUNCA commitar um valor real aqui - preencher
# so no .env real de cada ambiente. META_REDIRECT_URI precisa ser
# EXATAMENTE igual ao registrado no painel da Meta para este App (Facebook
# Login for Business > Settings > Valid OAuth Redirect URIs).
META_APP_ID=272228752803490817
META_APP_SECRET=
META_REDIRECT_URI="https://gestordevendas.ivillar.com.br/api/social/callback"
# Id da "Login Configuration" criada em App Dashboard > Facebook Login for
# Business > Configurations - substitui o parametro "scope" para Apps tipo
# Empresa (obrigatorio para GET /me/accounts realmente devolver as Paginas,
# mesmo com as permissoes concedidas no consentimento - ver MetaGraphApiOAuthService
# para o motivo). Nao e segredo, mas so faz sentido preencher se o App for
# tipo Empresa - deixar vazio faz o codigo cair no fluxo classico via scope.
META_LOGIN_CONFIG_ID=

# Modulo Redes Sociais (fatia DM Instagram/Facebook) - webhook de mensagens
# diretas. META_WEBHOOK_VERIFY_TOKEN e uma string aleatoria escolhida por
# voce (nao vem da Meta), cadastrada no painel da Meta (App Dashboard >
# Webhooks > Verify Token) E aqui - usada so no handshake de verificacao do
# GET /social/webhook (hub.verify_token). NUNCA commitar um valor real aqui -
# preencher so no .env real de cada ambiente. A validacao dos eventos reais
# (POST /social/webhook) usa META_APP_SECRET (acima), via assinatura
# X-Hub-Signature-256 - nao precisa de variavel propria.
META_WEBHOOK_VERIFY_TOKEN=
