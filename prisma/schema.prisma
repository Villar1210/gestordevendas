// prisma/schema.prisma
// Ecossistema: gestaodevendas
// Modulo: Base + Autenticacao (Fase 1 + Fase 2)

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Isolamento Multitenant: cada empresa cliente (imobiliaria) e um Tenant
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  // Dados da empresa (razao social = "name" acima, ja usado desde o
  // cadastro inicial) para qualificar o CONTRATANTE no contrato de
  // prestacao de servico (modulo rh, ver GerarContratoPrestacaoServicoUseCase)
  // e qualquer outro documento futuro que precise dos dados formais da
  // empresa. Preenchidos pelo Administrador em /dashboard/configuracoes
  // (modulo configuracoes) - nulos ate la, ja que nenhum tenant existente
  // tinha esses dados antes desta fatia.
  cnpj        String? @db.VarChar(20)
  endereco    String? @db.VarChar(200)
  numero      String? @db.VarChar(20)
  complemento String? @db.VarChar(100)
  bairro      String? @db.VarChar(100)
  cep         String? @db.VarChar(10)

  roles Role[]
  users User[]

  whatsAppSessions WhatsAppSession[]
  whatsAppMessages WhatsAppMessage[]

  pipelines  Pipeline[]
  stages     Stage[]
  cards      Card[]
  activities Activity[]
  notes      Note[]

  empreendimentos Empreendimento[]
  imoveis         Imovel[]
  imovelPhotos    ImovelPhoto[]

  proprietarios          Proprietario[]
  inquilinosCompradores  InquilinoComprador[]
  contratos              Contrato[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  inquilinoDocumentos    InquilinoDocumento[]

  viviConversations ViviConversation[]

  filas        Fila[]
  atendimentos Atendimento[]

  roletaConfig RoletaConfig?
  viviConfig   ViviConfig?

  signatureEnvelopes SignatureEnvelope[]

  contratoTemplates ContratoTemplate[]
  emailTemplates    EmailTemplate[]
  notifications     Notification[]
  stands            Stand[]
  escalasPlantao    EscalaPlantao[]

  // Modulo Super Usuario: trilha de auditoria de quem (de fora deste
  // tenant) acessou os dados dele via impersonacao - ver
  // AcessoPlataformaLog. onDelete: SetNull no lado de la (nao aqui) para
  // o log sobreviver mesmo se este tenant for excluido no futuro.
  acessosPlataforma AcessoPlataformaLog[]

  // VIVI - busca de empreendimento por endereco (ver modulo vivi_sdr).
  enderecoBuscaLogs EnderecoBuscaLog[]

  // Motor de campanha de Repique (ver ProcessarCampanhaRepiqueUseCase).
  repiqueCampanhaEnvios RepiqueCampanhaEnvio[]

  // Modulo Redes Sociais (fatia 1 - so modelagem, ver comentario acima de
  // SocialAccount).
  socialAccounts    SocialAccount[]
  socialPosts       SocialPost[]
  socialMediaAssets SocialMediaAsset[]

  // Modulo Redes Sociais (fatia DM) - historico bruto de DMs (SocialMessage)
  // e conversas da VIVI via Instagram/Facebook (SocialConversation) - ver
  // comentario acima dos dois models para o motivo de serem paralelos a
  // WhatsAppMessage/ViviConversation em vez de generaliza-los.
  socialMessages      SocialMessage[]
  socialConversations SocialConversation[]

  @@map("tenants")
}

// Cargos customizaveis por empresa (Administrador, Vendedor, SDR, etc.)
model Role {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(50)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@map("roles")
}

// Usuarios do sistema, sempre vinculados a um Tenant e a um Role
model User {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  twoFactorEnabled      Boolean @default(false) @map("two_factor_enabled")
  // Presenca do usuario para o modulo RH/Equipe: "online", "ausente" ou
  // "offline". Atualizado pelo proprio usuario (seletor na Topbar) ou
  // automaticamente para "online" no login.
  statusDisponibilidade String  @default("offline") @map("status_disponibilidade") @db.VarChar(10)

  // Modulo RH completo: cadastro publico multi-perfil + aprovacao.
  // "aprovado" e o default para nao travar contas ja existentes (criadas
  // por Administrador ou pelo seed) - so o PublicSignupUseCase grava
  // "pendente_aprovacao" explicitamente. Valores: pendente_aprovacao,
  // aprovado, rejeitado.
  statusCadastro     String  @default("aprovado") @map("status_cadastro") @db.VarChar(20)
  // Onboarding do Corretor: forca a troca de senha no proximo login quando
  // true. Default false preserva contas existentes e o cadastro publico
  // (onde o proprio usuario ja escolhe a senha) - so CreateCorretorUseCase
  // (modulo rh) grava true explicitamente. Zerado automaticamente sempre
  // que a senha muda de verdade (ver PrismaUserRepository.updatePassword,
  // usado tanto por "Meu Perfil" quanto por "Esqueci minha senha").
  mustChangePassword Boolean @default(false) @map("must_change_password")
  telefone           String? @db.VarChar(30)
  cpf                String? @db.VarChar(20)
  // Corretor House / Corretor Parceiro.
  creci              String? @db.VarChar(30)
  // Imobiliaria Parceira.
  nomeImobiliaria    String? @map("nome_imobiliaria") @db.VarChar(150)
  cnpj               String? @db.VarChar(20)
  creciJ             String? @map("creci_j") @db.VarChar(30)
  cargoNaEmpresa     String? @map("cargo_na_empresa") @db.VarChar(100)
  // Hierarquia (House / Imobiliaria Parceira), preenchida na aprovacao.
  cargoHierarquico   String? @map("cargo_hierarquico") @db.VarChar(30)
  superiorId         String? @map("superior_id") @db.Uuid
  // So relevante quando o Role for Cliente: comprador, proprietario ou ambos.
  tipoCliente        String? @map("tipo_cliente") @db.VarChar(20)
  cep                String? @db.VarChar(10)
  endereco           String? @db.VarChar(200)

  // Contrato de prestacao de servico gerado automaticamente na aprovacao
  // (modulo rh, ver GerarContratoPrestacaoServicoUseCase) - nulo ate a
  // aprovacao acontecer, ou se o roleName nao exigir contrato (ex:
  // Cliente). Rastreamento visivel na tela de Aprovacoes (aba "Aprovados").
  contratoPrestacaoServicoEnvelopeId String? @unique @map("contrato_prestacao_servico_envelope_id") @db.Uuid

  // Modulo Plantao/Stand - stand FIXO que este usuario coordena, so
  // relevante quando cargoHierarquico = "coordenador" (diferente de
  // EscalaPlantao, que e o padrao ROTATIVO dos corretores - podem
  // trabalhar em varios stands por dia). onDelete: SetNull para nao travar
  // a exclusao de um Stand por causa do Coordenador vinculado (a propria
  // DeleteStandUseCase ja bloqueia antes disso, ver modulo plantao).
  standId String? @map("stand_id") @db.Uuid

  tenant                           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                             Role               @relation(fields: [roleId], references: [id])
  superior                         User?              @relation("UserHierarchy", fields: [superiorId], references: [id], onDelete: SetNull)
  subordinados                     User[]             @relation("UserHierarchy")
  contratoPrestacaoServicoEnvelope SignatureEnvelope? @relation("UserContratoPrestacaoServico", fields: [contratoPrestacaoServicoEnvelopeId], references: [id], onDelete: SetNull)
  standCoordenado                  Stand?             @relation(fields: [standId], references: [id], onDelete: SetNull)
  escalasPlantao                   EscalaPlantao[]

  passwordResetTokens       PasswordResetToken[]
  twoFactorCodes            TwoFactorCode[]
  whatsAppSessions          WhatsAppSession[]
  ownedCards                Card[]
  // Cards onde este usuario e a sugestao pendente da Roleta Online
  // (modo semi_automatico) - ver CardSuggestedOwner em Card.
  suggestedCards            Card[]               @relation("CardSuggestedOwner")
  createdSignatureEnvelopes SignatureEnvelope[]

  filaVinculos       FilaUsuario[]
  atendimentosDono   Atendimento[]
  atendimentoEventos AtendimentoEvento[]
  notifications      Notification[]

  // Modulo Redes Sociais (fatia 1 - so modelagem).
  socialPostsAutoria      SocialPost[]       @relation("SocialPostAuthor")
  socialMediaAssetsUpload SocialMediaAsset[] @relation("SocialMediaAssetUploader")

  // Modulo Super Usuario: presente so em usuarios com Role "Super
  // Usuario" (unico tenant "Plataforma", criado via seed manual - ver
  // scripts/seed-super-usuario.ts). Registra os acessos que ESTE usuario
  // fez a outros tenants via impersonacao.
  acessosPlataformaComoSuperUsuario AcessoPlataformaLog[]

  @@map("users")
}

// Modulo RH - geracao automatica de contrato de prestacao de servico.
// Texto do contrato com placeholders ({{NOME}}, {{CPF}}, etc, preenchidos
// por preencher-contrato-template.ts) guardado no banco (nao fixo no
// codigo) para permitir customizacao futura pelo Administrador. "padrao"
// marca qual template e usado automaticamente na aprovacao de um cadastro
// (GetOrCreateContratoTemplateUseCase cria um com texto generico na
// primeira vez que um tenant precisa, mesmo padrao ja usado para as filas
// padrao do modulo Atendimento) - nao e @@unique de proposito, para deixar
// aberto ter mais de um template por tenant no futuro (so 1 marcado como
// padrao por vez, mas isso nao e reforcado no banco ainda nesta fatia).
model ContratoTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String   @db.VarChar(150)
  corpo     String   @db.Text
  padrao    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("contrato_templates")
}

// Templates de e-mail editaveis por tenant (Fatia 4 do Painel
// Administrativo) - "tipo" identifica QUAL e-mail do fluxo de RH
// (boas_vindas_corretor/rejeicao_cadastro/aprovacao_cadastro, ver
// domain/services/email-template-tipos.ts), unico por tenant+tipo.
// Get-or-create com defaults hardcoded na primeira leitura (mesmo padrao
// ja usado por ContratoTemplate/ViviConfig).
model EmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tipo      String   @db.VarChar(50)
  assunto   String   @db.VarChar(200)
  corpo     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tipo])
  @@map("email_templates")
}

// Notificacoes in-app (Fatia 5 do Painel Administrativo) - sino na Topbar.
// Sempre por USUARIO especifico (nao por tenant inteiro) - um gatilho pode
// gerar 1 notificacao por Administrador, por exemplo (ver
// infra/listeners/cadastro-pendente-criado.listener.ts no modulo
// notificacoes). "link" e opcional (nem toda notificacao leva a algum
// lugar clicavel).
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tipo      String   @db.VarChar(50)
  mensagem  String   @db.VarChar(300)
  link      String?  @db.VarChar(300)
  lida      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Modulo Super Usuario: trilha de auditoria de impersonacao (dono da
// plataforma SaaS "entrando como Administrador" num tenant qualquer -
// ver src/modules/super_usuario). tenantId e nullable + onDelete:SetNull
// (nao Cascade) DE PROPOSITO - o log de quem acessou o que deve
// sobreviver mesmo que o tenant acessado seja excluido depois;
// tenantNome guarda o nome no momento do acesso, ja que apos SetNull
// nao ha mais como buscar o nome pela relacao.
model AcessoPlataformaLog {
  id             String   @id @default(uuid()) @db.Uuid
  superUsuarioId String   @map("super_usuario_id") @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  tenantNome     String   @map("tenant_nome") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at")

  superUsuario User    @relation(fields: [superUsuarioId], references: [id], onDelete: Cascade)
  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@map("acessos_plataforma_log")
}

// Modulo Plantao/Stand de vendas. Um stand e um local fisico onde
// corretores atendem (ex: "Stand Centro") - conceito novo, distinto de
// Empreendimento (que e um imovel/obra a venda, nao um escritorio da
// equipe). So Administrador gerencia (criar/editar/excluir stands e
// definir a escala) - ver modulo plantao.
model Stand {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String   @db.VarChar(150)
  endereco  String?  @db.VarChar(200)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  escalas       EscalaPlantao[]
  coordenadores User[]

  @@map("stands")
}

// Escala SEMANAL recorrente (nao uma data especifica) - diaSemana segue
// o mesmo padrao de Date.getDay() do JavaScript (0=domingo...6=sabado).
// Um corretor pode ter varias linhas (varios stands e/ou varios dias) -
// a unique constraint so impede duplicar a MESMA combinacao
// stand+corretor+dia. Editavel a qualquer momento pelo Administrador -
// "escala semanal" aqui significa um padrao vigente, nao um historico
// (sem coluna de data, de proposito).
model EscalaPlantao {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  standId   String @map("stand_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  diaSemana Int    @map("dia_semana")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stand  Stand  @relation(fields: [standId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([standId, userId, diaSemana])
  @@map("escalas_plantao")
}

// Tokens de uso unico para o fluxo de "esqueci a senha"
model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Codigos de uso unico para o segundo fator de autenticacao (2FA) por e-mail
model TwoFactorCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_codes")
}

// Uma conexao de WhatsApp via QR Code (Baileys) pertencente a um Tenant,
// opcionalmente vinculada ao corretor/usuario dono do numero.
model WhatsAppSession {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  label       String   @db.VarChar(100)
  status      String   @default("PENDING_QR") @db.VarChar(20)
  phoneNumber String?  @map("phone_number") @db.VarChar(30)
  // Marca se esta sessao especifica e atendida pela VIVI (assistente de IA)
  // em vez do corretor humano dono do numero.
  isAiEnabled Boolean  @default(false) @map("is_ai_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner             User?              @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  messages          WhatsAppMessage[]
  viviConversations ViviConversation[]
  atendimentos      Atendimento[]

  @@map("whatsapp_sessions")
}

// Historico de mensagens trocadas em uma sessao de WhatsApp.
// Apenas armazenamento: nao dispara Card nem roteamento para SDR.
model WhatsAppMessage {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  direction  String   @db.VarChar(3) // "IN" ou "OUT"
  fromNumber String   @map("from_number") @db.VarChar(30)
  toNumber   String   @map("to_number") @db.VarChar(30)
  // JID completo do Baileys, com sufixo (@lid ou @s.whatsapp.net).
  // fromNumber/toNumber guardam so os digitos (exibicao); remoteJid e o
  // valor correto para RESPONDER - numeros @lid nao sao um MSISDN valido
  // sob @s.whatsapp.net, entao reconstruir o JID a partir dos digitos
  // quebra o envio. Nulo em mensagens antigas, anteriores a essa correcao.
  remoteJid  String?  @map("remote_jid") @db.VarChar(50)
  body       String   @db.Text
  timestamp  DateTime
  createdAt  DateTime @default(now()) @map("created_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("whatsapp_messages")
}

// Uma conversa da VIVI (assistente SDR de IA) com um lead via WhatsApp.
// Guarda o que ja foi coletado do lead e o status do atendimento. Quando
// a VIVI decide transferir para um corretor humano, cardId e preenchido
// com o Card criado na Caixa de Entrada (origem "roleta_online").
model ViviConversation {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  whatsappSessionId     String    @map("whatsapp_session_id") @db.Uuid
  phoneNumber           String    @map("phone_number") @db.VarChar(30)
  status                String    @default("em_andamento") @db.VarChar(30)
  nomeColetado          String?   @map("nome_coletado") @db.VarChar(150)
  tipoImovelColetado    String?   @map("tipo_imovel_coletado") @db.VarChar(50)
  orcamentoColetado     String?   @map("orcamento_coletado") @db.VarChar(100)
  regiaoColetado        String?   @map("regiao_coletado") @db.VarChar(150)
  finalidadeColetado    String?   @map("finalidade_coletado") @db.VarChar(20)
  cardId                String?   @map("card_id") @db.Uuid
  // Preenchido quando a tool "agendar_visita" e chamada - a meta absoluta
  // da VIVI (ver constants/vivi-prompt.ts). Diferente de qualificado_
  // transferido/encaminhado_fila, agendar uma visita NAO encerra a
  // conversa (status continua "em_andamento") - a VIVI segue coletando
  // dados pos-visita (nascimento/email/tipo de renda/IR) depois disso.
  visitaAgendadaEm      DateTime? @map("visita_agendada_em")
  // Renda familiar mensal aproximada declarada pelo lead, e a categoria
  // habitacional resultante (HIS1/HIS2/HMP/R2V/SEM_PERFIL) - sempre
  // calculada em codigo puro (ver domain/services/classificar-renda.ts),
  // nunca decidida pela IA. Usada para o argumento de venda certo na
  // conversa.
  rendaDeclarada        Float?    @map("renda_declarada")
  categoriaHabitacional String?   @map("categoria_habitacional") @db.VarChar(20)
  // Coletados SOMENTE apos visitaAgendadaEm ser preenchido (ver tool
  // "salvar_dados_pos_visita" - rejeitada em codigo se a visita ainda nao
  // foi confirmada, defesa em profundidade alem da ordem pedida no prompt).
  dataNascimento        String?   @map("data_nascimento") @db.VarChar(20)
  email                 String?   @db.VarChar(150)
  tipoRenda             String?   @map("tipo_renda") @db.VarChar(20)
  fezDeclaracaoIR       Boolean?  @map("fez_declaracao_ir")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session WhatsAppSession @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)
  card    Card?           @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@map("vivi_conversations")
}

// Fila de atendimento (modulo Central de Atendimento) - agrupa
// atendimentos por categoria (ex: Suporte, Financeiro, Duvidas Gerais) e
// define quais agentes podem atende-los (ver FilaUsuario). Independente
// de Pipeline/Stage do Kanban - atendimento de suporte/duvida nao e um
// "negocio" no funil de vendas, por isso vive num modulo proprio.
model Fila {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String   @db.VarChar(100)
  descricao String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarios     FilaUsuario[]
  atendimentos Atendimento[]

  @@map("filas")
}

// Vinculo N:N entre agente (User) e Fila - so agentes vinculados podem
// assumir atendimentos daquela fila (Administrador sempre pode, mesmo sem
// vinculo - ver AssignAtendimentoUseCase).
model FilaUsuario {
  id        String   @id @default(uuid()) @db.Uuid
  filaId    String   @map("fila_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  fila Fila @relation(fields: [filaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([filaId, userId])
  @@map("fila_usuarios")
}

// Uma conversa de atendimento (Central de Atendimento) com um contato via
// WhatsApp - paralelo ao Card do Kanban, mas para suporte/duvidas em vez
// de negociacao de venda. Criado automaticamente
// (GetOrCreateAtendimentoUseCase) quando uma mensagem chega numa sessao
// SEM VIVI ativa, ou quando a propria VIVI decide que a duvida nao e de
// venda (tool "transferir_para_fila" - ver ProcessIncomingMessageUseCase
// no modulo vivi_sdr).
model Atendimento {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  whatsappSessionId String    @map("whatsapp_session_id") @db.Uuid
  // JID completo (com sufixo @lid ou @s.whatsapp.net) - necessario para
  // responder corretamente (ver CLAUDE.md, bug do JID @lid).
  remoteJid         String    @map("remote_jid") @db.VarChar(50)
  phoneNumber       String    @map("phone_number") @db.VarChar(30)
  // Nulo ate ser classificado manualmente (ClassifyAndRouteAtendimentoUseCase)
  // ou pela VIVI.
  filaId            String?   @map("fila_id") @db.Uuid
  // Nulo ate um agente assumir (AssignAtendimentoUseCase).
  ownerId           String?   @map("owner_id") @db.Uuid
  // aguardando -> em_atendimento -> fechado (ou devolvido para aguardando
  // via RequeueAtendimentoUseCase).
  status            String    @default("aguardando") @db.VarChar(20)
  motivoFechamento  String?   @map("motivo_fechamento") @db.VarChar(300)
  // Marcado pela VIVI quando o lead pede explicitamente para falar com um
  // humano AGORA (ver ProcessIncomingMessageUseCase/vivi-prompt.ts) -
  // exibido como badge visual na Central de Atendimento.
  urgente           Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  closedAt          DateTime? @map("closed_at")

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session WhatsAppSession     @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)
  fila    Fila?               @relation(fields: [filaId], references: [id], onDelete: SetNull)
  owner   User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  eventos AtendimentoEvento[]

  @@map("atendimentos")
}

// Trilha de auditoria de um Atendimento - um evento por acao relevante
// (criado, atribuido, transferido, devolvido, fechado, nota).
model AtendimentoEvento {
  id            String   @id @default(uuid()) @db.Uuid
  atendimentoId String   @map("atendimento_id") @db.Uuid
  tipo          String   @db.VarChar(20)
  userId        String?  @map("user_id") @db.Uuid
  detalhe       String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("atendimento_eventos")
}

// Um funil de vendas (ex: "Vendas Imoveis"). Um tenant pode ter varios.
model Pipeline {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages Stage[]
  cards  Card[]

  @@map("pipelines")
}

// Uma coluna do Kanban dentro de um Pipeline. "position" e Float para
// permitir reordenar por arraste sem precisar reindexar as demais colunas.
model Stage {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  pipelineId String @map("pipeline_id") @db.Uuid
  name       String @db.VarChar(100)
  position   Float

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@map("stages")
}

// Um card (lead/oportunidade), sempre vinculado a um Pipeline. "stageId"
// e opcional: nulo significa que o card esta na Caixa de Entrada, ainda
// sem coluna e sem dono. "position" e Float pelo mesmo motivo do Stage
// (algoritmo de posicionamento flutuante).
model Card {
  id                         String    @id @default(uuid()) @db.Uuid
  tenantId                   String    @map("tenant_id") @db.Uuid
  pipelineId                 String    @map("pipeline_id") @db.Uuid
  stageId                    String?   @map("stage_id") @db.Uuid
  ownerId                    String?   @map("owner_id") @db.Uuid
  // Sugestao da Roleta Online (modo semi_automatico): corretor sugerido
  // para assumir o lead, ainda sem confirmacao (ownerId continua nulo ate
  // ConfirmSuggestedOwnerUseCase ser chamado). Ver modulo roleta_online.
  suggestedOwnerId           String?   @map("suggested_owner_id") @db.Uuid
  // Timeout de aceite da Roleta Online (modo automatico, ver
  // roleta_online/domain/services/pick-corretor.ts e
  // ProcessRoletaTimeoutsUseCase): preenchido no momento da atribuicao
  // automatica, limpo quando aceito ou quando reatribuido para outro
  // corretor. NULL = card nao passou pelo modo automatico da Roleta (claim
  // manual, semi_automatico, ou ja aceito/reatribuido sem mais ninguem
  // online para reatribuir - ver clearAtribuidoAutomaticamente).
  atribuidoAutomaticamenteEm DateTime? @map("atribuido_automaticamente_em")
  // Preenchido quando o proprio corretor clica em "Aceitar Lead" - so tem
  // sentido junto com atribuidoAutomaticamenteEm preenchido.
  aceitoEm                   DateTime? @map("aceito_em")
  imovelId                   String?   @map("imovel_id") @db.Uuid
  title                      String    @db.VarChar(200)
  value                      Decimal   @default(0) @db.Decimal(12, 2)
  position                   Float
  origem                     String    @default("manual") @db.VarChar(20)
  phone                      String?   @db.VarChar(30)
  temperatura                String?   @db.VarChar(10)
  email                      String?   @db.VarChar(150)
  endereco                   String?   @db.VarChar(200)
  numero                     String?   @db.VarChar(20)
  complemento                String?   @db.VarChar(100)
  bairro                     String?   @db.VarChar(100)
  cep                        String?   @db.VarChar(10)
  // Motivo de mover o card para a stage "Repique" (deposito de
  // remarketing/reengajamento) - preenchido manualmente (modal obrigatorio
  // no Kanban) ou automaticamente pelo job de inatividade de 90 dias (ver
  // vendas_kanban/domain/services/motivo-repique.ts para os valores
  // validos). Nulo para cards que nunca passaram por Repique - nao e
  // limpo se o card sair de Repique depois, fica como registro historico.
  motivoRepique              String?   @map("motivo_repique") @db.VarChar(30)
  // Quando o card ENTROU na stage Repique (manual ou automatico) - NAO
  // usar updatedAt como proxy disso, ja que updatedAt e bumpado por
  // qualquer edicao do card (nota, atividade, etc.), nao so ao mudar de
  // stage - decisao confirmada antes de implementar o job de Repique.
  movidoParaRepiqueEm        DateTime? @map("movido_para_repique_em")
  // Motor de campanha de Repique (ver ProcessarCampanhaRepiqueUseCase) -
  // opt-out obrigatorio (LGPD). repiqueOptOutToken e gerado sob demanda,
  // no primeiro envio de campanha (nao na criacao do card) - fica nulo
  // ate la. Unico (@unique) porque e usado para localizar o card a partir
  // do link publico de descadastro, sem precisar de tenantId/autenticacao.
  repiqueOptOut              Boolean   @default(false) @map("repique_opt_out")
  repiqueOptOutToken         String?   @unique @map("repique_opt_out_token") @db.VarChar(64)
  // Resumo automatico legivel pelo corretor sem abrir outra tela - hoje so
  // preenchido pela VIVI (transferir_para_corretor/agendar_visita, ver
  // domain/services/build-resumo-atendimento.ts no modulo vivi_sdr), mas
  // disponivel para qualquer outro fluxo futuro que queira usa-lo.
  description                String?   @db.Text
  customFields               Json      @default("{}") @map("custom_fields")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline              Pipeline               @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage                 Stage?                 @relation(fields: [stageId], references: [id], onDelete: Cascade)
  owner                 User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  suggestedOwner        User?                  @relation("CardSuggestedOwner", fields: [suggestedOwnerId], references: [id], onDelete: SetNull)
  imovel                Imovel?                @relation(fields: [imovelId], references: [id], onDelete: SetNull)
  activities            Activity[]
  notes                 Note[]
  viviConversations     ViviConversation[]
  repiqueCampanhaEnvios RepiqueCampanhaEnvio[]
  socialConversations   SocialConversation[]

  @@map("cards")
}

// Motor de campanha de remarketing escalonada do Repique - 1 registro por
// TENTATIVA de envio (inclusive falhas, ex: e-mail nao cadastrado, sessao
// WhatsApp desconectada), usado pelo job (ProcessarCampanhaRepiqueUseCase)
// para decidir o proximo canal (alterna EMAIL/WHATSAPP a partir do ultimo
// registro) e o intervalo minimo de 2 dias entre envios.
model RepiqueCampanhaEnvio {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  cardId               String   @map("card_id") @db.Uuid
  canal                String   @db.VarChar(20) // "WHATSAPP" ou "EMAIL" (ver shared/domain/enums/canal.enum.ts)
  enviadoEm            DateTime @default(now()) @map("enviado_em")
  // Snapshot do Card.motivoRepique NO MOMENTO deste envio - preserva o
  // motivo mesmo se o card for editado/movido depois, para analise
  // historica de qual motivo gerou qual campanha.
  motivoRepiqueNoEnvio String?  @map("motivo_repique_no_envio") @db.VarChar(30)
  sucesso              Boolean
  erroMensagem         String?  @map("erro_mensagem") @db.Text

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("repique_campanha_envios")
}

// Um empreendimento imobiliario (ex: um condominio) que agrupa varias
// unidades (Imovel). Opcional: um Imovel pode ser avulso, sem empreendimento.
model Empreendimento {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(150)
  rua         String   @db.VarChar(200)
  numero      String   @db.VarChar(20)
  bairro      String   @db.VarChar(100)
  cidade      String   @db.VarChar(100)
  uf          String   @db.VarChar(2)
  cep         String   @db.VarChar(10)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imoveis Imovel[]

  @@map("empreendimentos")
}

// Uma unidade/imovel disponivel para venda e/ou aluguel. Pode pertencer a
// um Empreendimento ou ser avulso (empreendimentoId nulo).
model Imovel {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  empreendimentoId     String?   @map("empreendimento_id") @db.Uuid
  title                String    @db.VarChar(200)
  codigoInterno        String?   @map("codigo_interno") @db.VarChar(50)
  tipo                 String    @db.VarChar(20)
  uso                  String?   @db.VarChar(20)
  finalidade           String    @db.VarChar(10)
  tags                 String?   @db.Text
  price                Decimal?  @db.Decimal(12, 2)
  rentPrice            Decimal?  @map("rent_price") @db.Decimal(12, 2)
  area                 Float?
  bedrooms             Int?
  bathrooms            Int?
  parkingSpots         Int?      @map("parking_spots")
  rua                  String?   @db.VarChar(200)
  numero               String?   @db.VarChar(20)
  complemento          String?   @db.VarChar(100)
  bairro               String?   @db.VarChar(100)
  cidade               String?   @db.VarChar(100)
  uf                   String?   @db.VarChar(2)
  cep                  String?   @db.VarChar(10)
  description          String?   @db.Text
  status               String    @default("disponivel") @db.VarChar(20)
  disponivelApartirDe  DateTime? @map("disponivel_a_partir_de")
  localChaves          String?   @map("local_chaves") @db.VarChar(20)
  exclusividade        Boolean   @default(false)
  proprietarioNome     String?   @map("proprietario_nome") @db.VarChar(150)
  proprietarioTelefone String?   @map("proprietario_telefone") @db.VarChar(30)
  customFields         Json      @default("{}") @map("custom_fields")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empreendimento Empreendimento? @relation(fields: [empreendimentoId], references: [id], onDelete: SetNull)
  photos         ImovelPhoto[]
  cards          Card[]
  contratos      Contrato[]

  @@map("imoveis")
}

// Uma foto de um Imovel, ordenavel na vitrine (order).
model ImovelPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  imovelId  String   @map("imovel_id") @db.Uuid
  url       String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("imovel_photos")
}

// Dono de um imovel (vendedor/locador). Vinculado ao Imovel apenas atraves
// do Contrato (imovel.proprietarioNome/proprietarioTelefone continuam sendo
// campos simples, sem FK - ver CLAUDE.md sobre a futura entidade formal do
// modulo RH/Cadastros).
model Proprietario {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  nome        String   @db.VarChar(150)
  cpfCnpj     String?  @map("cpf_cnpj") @db.VarChar(20)
  telefone    String   @db.VarChar(30)
  email       String?  @db.VarChar(150)
  rua         String?  @db.VarChar(200)
  numero      String?  @db.VarChar(20)
  complemento String?  @db.VarChar(100)
  bairro      String?  @db.VarChar(100)
  cidade      String?  @db.VarChar(100)
  uf          String?  @db.VarChar(2)
  cep         String?  @db.VarChar(10)
  // Dados bancarios para repasse financeiro futuro (aluguel, venda).
  banco       String?  @db.VarChar(100)
  agencia     String?  @db.VarChar(20)
  conta       String?  @db.VarChar(20)
  pix         String?  @db.VarChar(150)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratos Contrato[]

  @@map("proprietarios")
}

// Quem compra ou aluga um imovel. Fatia 5 (Moradores/Inquilinos) adicionou
// analise de credito (profissao/renda/status/observacoes) e documentos
// anexados (InquilinoDocumento).
model InquilinoComprador {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  nome                 String   @db.VarChar(150)
  cpfCnpj              String?  @map("cpf_cnpj") @db.VarChar(20)
  telefone             String   @db.VarChar(30)
  email                String?  @db.VarChar(150)
  profissao            String?  @db.VarChar(100)
  rendaDeclarada       Decimal? @map("renda_declarada") @db.Decimal(12, 2)
  // nao_iniciada, em_analise, aprovado, reprovado.
  statusAnaliseCredito String   @default("nao_iniciada") @map("status_analise_credito") @db.VarChar(20)
  observacoesAnalise   String?  @map("observacoes_analise") @db.Text
  createdAt            DateTime @default(now()) @map("created_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratos  Contrato[]
  documentos InquilinoDocumento[]

  @@map("inquilinos_compradores")
}

// Um documento anexado a analise de credito de um InquilinoComprador (RG/CPF,
// comprovante de renda, comprovante de residencia, outro). Mesmo padrao de
// armazenamento ja usado para fotos de imovel e documentos do E-doc
// (IFileStorageService, trocavel).
model InquilinoDocumento {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  inquilinoId String   @map("inquilino_id") @db.Uuid
  // rg_cpf, comprovante_renda, comprovante_residencia, outro.
  tipo        String   @db.VarChar(30)
  url         String   @db.VarChar(500)
  nomeArquivo String   @map("nome_arquivo") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inquilino InquilinoComprador @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)

  @@map("inquilino_documentos")
}

// Contrato de venda ou locacao, ligando um Imovel a um Proprietario e a um
// InquilinoComprador. Ao criar, o Imovel.status muda automaticamente
// (vendido/ocupado); ao encerrar, volta (disponivel/vago) - ver
// CreateContratoUseCase / EncerrarContratoUseCase.
model Contrato {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  imovelId             String    @map("imovel_id") @db.Uuid
  proprietarioId       String    @map("proprietario_id") @db.Uuid
  inquilinoCompradorId String    @map("inquilino_comprador_id") @db.Uuid
  tipo                 String    @db.VarChar(10) // "venda" ou "locacao"
  valor                Decimal   @db.Decimal(12, 2)
  dataInicio           DateTime  @map("data_inicio")
  // Opcional - usado em locacao (fim do contrato); venda pode deixar nulo
  // ou usar como data de conclusao.
  dataFim              DateTime? @map("data_fim")
  // Dia do mes para vencimento do aluguel - so relevante em locacao.
  diaVencimento        Int?      @map("dia_vencimento")
  status               String    @default("ativo") @db.VarChar(20) // ativo, encerrado, cancelado
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imovel                 Imovel                 @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  proprietario           Proprietario           @relation(fields: [proprietarioId], references: [id], onDelete: Cascade)
  inquilinoComprador     InquilinoComprador     @relation(fields: [inquilinoCompradorId], references: [id], onDelete: Cascade)
  lancamentosFinanceiros LancamentoFinanceiro[]

  @@map("contratos")
}

// Modulo Financeiro (Fatia 4 da Gestao Imobiliaria). Um lancamento pode ser
// manual/avulso (contratoId nulo) ou gerado automaticamente a partir de um
// Contrato de locacao (GerarCobrancasDoMesUseCase, categoria "aluguel").
// "receita" = a receber do inquilino/comprador; "repasse" = a pagar ao
// proprietario (ex: repasse de aluguel apos descontar taxa de administracao).
model LancamentoFinanceiro {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  contratoId String?   @map("contrato_id") @db.Uuid
  tipo       String    @db.VarChar(10) // "receita" ou "repasse"
  categoria  String    @db.VarChar(30) // aluguel, venda, taxa_administracao, manutencao, outro
  valor      Decimal   @db.Decimal(12, 2)
  vencimento DateTime
  status     String    @default("pendente") @db.VarChar(20) // pendente, pago, atrasado
  pagoEm     DateTime? @map("pago_em")
  descricao  String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrato Contrato? @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@map("lancamentos_financeiros")
}

// Uma atividade agendada/registrada para um card (ligacao, reuniao, visita,
// tarefa, proposta). "done" marca se ja foi concluida.
model Activity {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  cardId      String    @map("card_id") @db.Uuid
  type        String    @db.VarChar(20)
  subject     String?   @db.VarChar(200)
  scheduledAt DateTime? @map("scheduled_at")
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("activities")
}

// Uma anotacao de texto livre associada a um card.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("notes")
}

// Configuracao da Roleta Online (distribuicao automatica de leads sem dono
// entre corretores online) - uma unica config por tenant. ultimoCorretorId
// e um ponteiro simples (sem FK) usado pelo algoritmo round_robin para saber
// quem foi o ultimo a receber um lead.
model RoletaConfig {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @unique @map("tenant_id") @db.Uuid
  algoritmo            String   @default("round_robin") @db.VarChar(20) // "round_robin" ou "menor_fila"
  modo                 String   @default("semi_automatico") @db.VarChar(20) // "automatico" ou "semi_automatico"
  ativa                Boolean  @default(false)
  ultimoCorretorId     String?  @map("ultimo_corretor_id") @db.Uuid
  // So se aplica ao modo "automatico" - quantos minutos o corretor tem
  // para clicar em "Aceitar Lead" antes do card ser reatribuido ao
  // proximo da fila (ver ProcessRoletaTimeoutsUseCase).
  timeoutAceiteMinutos Int      @default(5) @map("timeout_aceite_minutos")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("roleta_configs")
}

// Configuracao de negocio da VIVI (assistente SDR de IA) - uma unica config
// por tenant. Preco minimo e as 4 faixas de renda (SEM_PERFIL/HIS1/HIS2/
// HMP - acima de limiteHmp e R2V) sao interpolados no system prompt (ver
// buildViviSystemPrompt) E usados por classificarRenda() para a
// classificacao autoritativa - as duas fontes leem os mesmos valores desta
// tabela, nunca hardcoded. Get-or-create com os defaults abaixo na
// primeira leitura (mesmo padrao ja usado por ContratoTemplate/RoletaConfig).
// Faixas de renda MCMV 2026 (substituem a nomenclatura HIS1/HIS2/HMP/R2V
// antiga - ver classificar-renda.ts). limiteFaixa1..4 sao os TETOS de
// renda de cada faixa (renda acima de limiteFaixa4 cai no argumento R2V,
// inalterado); limiteSemPerfil continua um corte MINIMO separado, abaixo
// do qual o lead vai pro Repique (ClassificarRenda.SEM_PERFIL) - decisao
// confirmada com o usuario: a Faixa 1 NAO substitui esse corte. Cada
// faixa ganhou campos de detalhe (subsidio/juros/teto de financiamento/
// exemplo de parcela) - todos opcionais (nullable) porque nem toda faixa
// tem subsidio (Faixa 3/4 normalmente nao tem) e exemploParcela e
// deliberadamente livre para o Administrador preencher ou nao.
model ViviConfig {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @unique @map("tenant_id") @db.Uuid
  precoMinimo     Decimal @default(264000) @map("preco_minimo") @db.Decimal(12, 2)
  limiteSemPerfil Decimal @default(1500) @map("limite_sem_perfil") @db.Decimal(12, 2)

  limiteFaixa1 Decimal @default(3200) @map("limite_faixa1") @db.Decimal(12, 2)
  limiteFaixa2 Decimal @default(5000) @map("limite_faixa2") @db.Decimal(12, 2)
  limiteFaixa3 Decimal @default(9600) @map("limite_faixa3") @db.Decimal(12, 2)
  // Faixa 4 (NOVA, 2026): MCMV Premium.
  limiteFaixa4 Decimal @default(13000) @map("limite_faixa4") @db.Decimal(12, 2)

  faixa1SubsidioMax       Decimal? @default(55000) @map("faixa1_subsidio_max") @db.Decimal(12, 2)
  faixa1JurosMin          Decimal? @default(4.00) @map("faixa1_juros_min") @db.Decimal(5, 2)
  faixa1JurosMax          Decimal? @default(4.50) @map("faixa1_juros_max") @db.Decimal(5, 2)
  faixa1TetoFinanciamento String?  @map("faixa1_teto_financiamento") @db.VarChar(100)
  faixa1ExemploParcela    String?  @map("faixa1_exemplo_parcela") @db.VarChar(300)

  faixa2SubsidioMax       Decimal? @default(55000) @map("faixa2_subsidio_max") @db.Decimal(12, 2)
  faixa2JurosMin          Decimal? @default(4.75) @map("faixa2_juros_min") @db.Decimal(5, 2)
  faixa2JurosMax          Decimal? @default(6.50) @map("faixa2_juros_max") @db.Decimal(5, 2)
  faixa2TetoFinanciamento String?  @default("R$ 275 mil a R$ 400 mil") @map("faixa2_teto_financiamento") @db.VarChar(100)
  faixa2ExemploParcela    String?  @map("faixa2_exemplo_parcela") @db.VarChar(300)

  // Faixa 3 normalmente sem subsidio - faixa3SubsidioMax fica null.
  faixa3SubsidioMax       Decimal? @map("faixa3_subsidio_max") @db.Decimal(12, 2)
  faixa3JurosMin          Decimal? @default(7.66) @map("faixa3_juros_min") @db.Decimal(5, 2)
  faixa3JurosMax          Decimal? @default(7.66) @map("faixa3_juros_max") @db.Decimal(5, 2)
  faixa3TetoFinanciamento String?  @default("R$ 400 mil") @map("faixa3_teto_financiamento") @db.VarChar(100)
  faixa3ExemploParcela    String?  @map("faixa3_exemplo_parcela") @db.VarChar(300)

  // Faixa 4 (NOVA) - MCMV Premium, tambem sem subsidio.
  faixa4SubsidioMax       Decimal? @map("faixa4_subsidio_max") @db.Decimal(12, 2)
  faixa4JurosMin          Decimal? @default(10.50) @map("faixa4_juros_min") @db.Decimal(5, 2)
  faixa4JurosMax          Decimal? @default(10.50) @map("faixa4_juros_max") @db.Decimal(5, 2)
  faixa4TetoFinanciamento String?  @default("R$ 600 mil") @map("faixa4_teto_financiamento") @db.VarChar(100)
  faixa4ExemploParcela    String?  @map("faixa4_exemplo_parcela") @db.VarChar(300)

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("vivi_configs")
}

// VIVI Fatia 2 (Desenvolvimento Tecnologico) - busca de empreendimento por
// endereco. Registra CADA busca (tool "buscar_empreendimento_por_endereco"),
// mesmo quando nada e encontrado - a analise de quais enderecos os leads
// pedem e nao existem no catalogo proprio e o proprio objetivo deste log
// (ajuda a identificar demanda futura), nao so uma trilha de auditoria.
model EnderecoBuscaLog {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  phoneNumber            String   @map("phone_number") @db.VarChar(30)
  enderecoBuscado        String   @map("endereco_buscado") @db.VarChar(300)
  encontradoCatalogo     Boolean  @map("encontrado_catalogo")
  nomeEncontradoCatalogo String?  @map("nome_encontrado_catalogo") @db.VarChar(200)
  // Preenchidos so quando o catalogo proprio nao encontrou nada.
  precisouBuscaExterna   Boolean  @default(false) @map("precisou_busca_externa")
  confirmadoExternamente Boolean? @map("confirmado_externamente")
  nomeEncontradoExterno  String?  @map("nome_encontrado_externo") @db.VarChar(200)
  // Escalonamento (transferir_para_fila/transferir_para_corretor) na MESMA
  // resposta que fez esta busca - so por urgencia/pedido explicito do lead
  // (ver vivi-prompt.ts, secao "Busca de empreendimento por endereco"),
  // nunca automatico so por nao ter encontrado o empreendimento.
  escalonado             Boolean  @default(false)
  motivoEscalonamento    String?  @map("motivo_escalonamento") @db.VarChar(50)
  createdAt              DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("endereco_busca_logs")
}

// Modulo E-doc (assinatura eletronica). Um envelope agrupa um documento
// (PDF) e a lista de destinatarios que precisam assina-lo, em ordem
// sequencial estrita (so o proximo recebe o link depois que o anterior
// assinar). Fatia 2 adicionou o editor de posicionamento (SignatureField)
// e signedDocumentUrl (o PDF final com as assinaturas embutidas).
model SignatureEnvelope {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  title             String    @db.VarChar(200)
  // rascunho -> aguardando_assinaturas -> concluido (ou cancelado a qualquer momento antes de concluido).
  status            String    @default("rascunho") @db.VarChar(30)
  documentUrl       String    @map("document_url") @db.VarChar(500)
  // SHA-256 do PDF original, calculado na criacao - prova de integridade do documento.
  documentHash      String    @map("document_hash") @db.VarChar(64)
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")
  // PDF final com as assinaturas embutidas (pdf-lib) - preenchido pelo
  // GenerateSignedPdfUseCase logo apos o envelope ficar "concluido".
  // Nulo ate la (e continua nulo se a geracao falhar - ver CLAUDE.md).
  signedDocumentUrl String?   @map("signed_document_url") @db.VarChar(500)
  // Assunto/mensagem customizaveis do e-mail de convite (Fatia 4) - nulos
  // se o usuario nao customizar, e o SendEnvelopeUseCase aplica o template
  // padrao definido em domain/services/envelope-validation.ts nesse caso
  // (default aplicado na camada de aplicacao, nao aqui no schema).
  emailSubject      String?   @map("email_subject") @db.VarChar(200)
  emailMessage      String?   @map("email_message") @db.Text

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy         User                 @relation(fields: [createdByUserId], references: [id])
  // Relacao reversa do FK opcional em User.contratoPrestacaoServicoEnvelopeId
  // (modulo rh) - o corretor/parceiro para quem este envelope especifico e
  // o contrato de prestacao de servico (se for esse o caso).
  usuarioContratado User?                @relation("UserContratoPrestacaoServico")
  recipients        SignatureRecipient[]
  events            SignatureEvent[]
  fields            SignatureField[]

  @@map("signature_envelopes")
}

// Um destinatario/signatario de um envelope. accessToken/tokenExpiresAt
// ficam nulos enquanto o envelope esta em "rascunho" - so sao gerados pelo
// SendEnvelopeUseCase, um por destinatario, no momento do envio (ver
// CLAUDE.md para a decisao sobre essa nulidade). Sem tenantId proprio de
// proposito: as rotas publicas (/edoc/sign/:token) nao tem contexto de
// tenant - o token e a propria fronteira de seguranca, e o acesso
// autenticado sempre passa pelo SignatureEnvelope (que ja e tenant-scoped)
// primeiro - mesmo padrao ja usado em PasswordResetToken/TwoFactorCode.
model SignatureRecipient {
  id                 String    @id @default(uuid()) @db.Uuid
  envelopeId         String    @map("envelope_id") @db.Uuid
  name               String    @db.VarChar(150)
  email              String    @db.VarChar(150)
  // Grupo de assinatura (Fatia 3): destinatario, remetente ou testemunha -
  // define tanto a cor/UI do participante quanto a ordem de ENVIO por
  // grupo (todos os destinatarios assinam, depois todos os remetentes,
  // depois todas as testemunhas - ver sortBySignatureSequence no dominio).
  role               String    @default("destinatario") @db.VarChar(20)
  // Ordem sequencial de assinatura DENTRO DO PROPRIO GRUPO de "role"
  // (Fatia 3) - comecando em 1 em cada grupo, nao mais uma ordem global
  // entre todos os participantes do envelope.
  order              Int
  accessToken        String?   @unique @map("access_token") @db.VarChar(255)
  tokenExpiresAt     DateTime? @map("token_expires_at")
  status             String    @default("pendente") @db.VarChar(20)
  signedAt           DateTime? @map("signed_at")
  // Base64 do canvas (data URL) OU o nome digitado, conforme o metodo escolhido na tela de assinatura.
  signatureImageData String?   @map("signature_image_data") @db.Text
  // SHA-256 do conteudo de signatureImageData.
  signatureHash      String?   @map("signature_hash") @db.VarChar(64)
  signerIp           String?   @map("signer_ip") @db.VarChar(45)
  signerUserAgent    String?   @map("signer_user_agent") @db.VarChar(500)

  envelope SignatureEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  events   SignatureEvent[]
  fields   SignatureField[]

  @@map("signature_recipients")
}

// Campo de assinatura posicionado sobre o PDF (Fatia 2) - por enquanto
// sempre 1 por destinatario, criado junto com o envelope
// (CreateEnvelopeUseCase). x/y/width/height sao percentuais (0-1)
// relativos ao tamanho da pagina, nao pixels absolutos - funciona em
// qualquer resolucao de tela ou tamanho real de pagina do PDF.
model SignatureField {
  id            String   @id @default(uuid()) @db.Uuid
  envelopeId    String   @map("envelope_id") @db.Uuid
  recipientId   String   @map("recipient_id") @db.Uuid
  // assinatura (padrao, tipicamente so na ultima pagina) ou rubrica
  // (Fatia 3, repetida em todas as paginas) - a repeticao em si e
  // responsabilidade do FRONTEND (gera 1 SignatureField por pagina com o
  // mesmo recipientId e tipo="rubrica" quando o usuario posiciona 1 vez);
  // o backend so recebe e salva a lista final de campos.
  tipo          String   @default("assinatura") @db.VarChar(20)
  pageNumber    Int      @map("page_number")
  xPercent      Float    @map("x_percent")
  yPercent      Float    @map("y_percent")
  widthPercent  Float    @default(0.2) @map("width_percent")
  heightPercent Float    @default(0.08) @map("height_percent")
  createdAt     DateTime @default(now()) @map("created_at")

  envelope  SignatureEnvelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipient SignatureRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("signature_fields")
}

// Trilha de auditoria do envelope - um evento por acao relevante (criado,
// enviado, visualizado, assinado, concluido, cancelado), com IP/User-Agent
// quando aplicavel (visualizado/assinado, vindos da rota publica).
model SignatureEvent {
  id          String   @id @default(uuid()) @db.Uuid
  envelopeId  String   @map("envelope_id") @db.Uuid
  recipientId String?  @map("recipient_id") @db.Uuid
  type        String   @db.VarChar(30)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  envelope  SignatureEnvelope   @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipient SignatureRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@map("signature_events")
}

// ============================================================
// Modulo Redes Sociais (agendamento e publicacao tipo mLabs/Zoho Social).
// Fatia 1: so a modelagem Prisma + item de menu (placeholder) - sem
// controllers, services de negocio ou adapters de plataforma ainda (ver
// plano completo nas fatias futuras). "canal"/"leadSourceChannel" abaixo
// reaproveitam o enum Canal (src/shared/domain/enums/canal.enum.ts, mesmo
// usado pelo MessageDispatcherService e pelo Repique) em vez de duplicar
// um enum de plataforma proprio - segue o padrao ja estabelecido no
// projeto de guardar esses valores como String @db.VarChar, nao um enum
// nativo do Prisma (nenhum model do schema usa "enum" nativo hoje).
// ============================================================

// Uma conta conectada (via OAuth futuro) em uma rede social especifica.
// accessToken/refreshToken ficam em texto puro por enquanto - mesmo padrao
// ja usado em SignatureRecipient.accessToken (sem criptografia em repouso
// ate hoje neste projeto); reavaliar se for exigido antes da fatia de
// conexao real via OAuth.
model SocialAccount {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  canal          String    @db.VarChar(20) // Canal enum - hoje so INSTAGRAM/FACEBOOK/LINKEDIN/TIKTOK/YOUTUBE fazem sentido aqui
  accountName    String    @map("account_name") @db.VarChar(150)
  externalId     String?   @map("external_id") @db.VarChar(255) // id da pagina/perfil na plataforma
  accessToken    String?   @map("access_token") @db.Text
  refreshToken   String?   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at")
  status         String    @default("DISCONNECTED") @db.VarChar(20) // CONNECTED, EXPIRED, ERROR, DISCONNECTED
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targets       SocialPostTarget[]
  messages      SocialMessage[]
  conversations SocialConversation[]

  @@map("social_accounts")
}

// Historico bruto de DMs (Instagram/Facebook Messenger) recebidas via
// webhook da Meta e enviadas de volta via MessageDispatcherService - papel
// paralelo ao de WhatsAppMessage (modulo whatsappmarketing), mas escopado
// por SocialAccount (Pagina/conta Instagram Business) em vez de
// WhatsAppSession. Vive no modulo social_media (o "canal"), lido pelo
// vivi_sdr (ProcessIncomingSocialMessageUseCase) para montar o historico da
// conversa - mesmo padrao de dependencia ja usado com WhatsAppMessage.
//
// DECISAO (fatia DM Instagram/Facebook): deliberadamente NAO generalizamos
// WhatsAppMessage/ViviConversation para aceitar qualquer canal - essas
// tabelas sao FK-obrigatorias para WhatsAppSession e estao em producao,
// ativamente usadas pelo fluxo WhatsApp. Criar modelos paralelos evita
// qualquer risco de regressao no WhatsApp, ao custo de alguma duplicacao de
// estrutura entre os dois pares de tabelas.
model SocialMessage {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  socialAccountId      String   @map("social_account_id") @db.Uuid
  direction            String   @db.VarChar(3) // "IN" ou "OUT"
  // PSID (Messenger) ou IGSID (Instagram) do lead - id do outro lado da
  // conversa, sempre o MESMO independente da direcao da mensagem.
  identificadorExterno String   @map("identificador_externo") @db.VarChar(255)
  body                 String   @db.Text
  timestamp            DateTime
  createdAt            DateTime @default(now()) @map("created_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, identificadorExterno])
  @@map("social_messages")
}

// Uma conversa da VIVI com um lead via DM (Instagram/Facebook) - papel
// paralelo ao de ViviConversation (modulo vivi_sdr), mas chaveada por
// SocialAccount + identificadorExterno (PSID/IGSID) em vez de
// whatsappSessionId + phoneNumber, ja que esses canais nao tem "numero de
// telefone". Ver decisao registrada no comentario de SocialMessage acima -
// mesmo raciocinio se aplica aqui.
model SocialConversation {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  socialAccountId       String    @map("social_account_id") @db.Uuid
  identificadorExterno  String    @map("identificador_externo") @db.VarChar(255)
  status                String    @default("em_andamento") @db.VarChar(30)
  nomeColetado          String?   @map("nome_coletado") @db.VarChar(150)
  tipoImovelColetado    String?   @map("tipo_imovel_coletado") @db.VarChar(50)
  orcamentoColetado     String?   @map("orcamento_coletado") @db.VarChar(100)
  regiaoColetado        String?   @map("regiao_coletado") @db.VarChar(150)
  finalidadeColetado    String?   @map("finalidade_coletado") @db.VarChar(20)
  cardId                String?   @map("card_id") @db.Uuid
  visitaAgendadaEm      DateTime? @map("visita_agendada_em")
  rendaDeclarada        Float?    @map("renda_declarada")
  categoriaHabitacional String?   @map("categoria_habitacional") @db.VarChar(20)
  dataNascimento        String?   @map("data_nascimento") @db.VarChar(20)
  email                 String?   @db.VarChar(150)
  tipoRenda             String?   @map("tipo_renda") @db.VarChar(20)
  fezDeclaracaoIR       Boolean?  @map("fez_declaracao_ir")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  card          Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([socialAccountId, identificadorExterno])
  @@map("social_conversations")
}

// Um post (conteudo + midia), potencialmente publicado em varias contas/
// plataformas ao mesmo tempo via SocialPostTarget (relacao N:N com
// SocialAccount, mediada pelo target). mediaUrls usa array nativo do
// Postgres (String[]) - primeiro uso desse recurso no projeto (os demais
// campos "lista" existentes, ex: Imovel.tags, sao texto separado por
// virgula) porque aqui o valor e sempre uma lista de URLs ja resolvidas,
// sem necessidade de parsing textual.
model SocialPost {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  authorId          String    @map("author_id") @db.Uuid
  content           String    @db.Text
  mediaUrls         String[]  @default([]) @map("media_urls")
  scheduledAt       DateTime? @map("scheduled_at")
  status            String    @default("DRAFT") @db.VarChar(20) // DRAFT, SCHEDULED, PUBLISHING, PUBLISHED, FAILED, PARTIAL
  // Reservado para uma futura entidade de Campanha (nao criada nesta
  // fatia) - sem relation() de proposito, so a coluna guardada desde ja
  // para nao exigir outra migration quando essa entidade existir.
  campaignId        String?   @map("campaign_id") @db.Uuid
  // Reservado para a fatia futura de captacao de leads via comentario/DM
  // do Instagram/Facebook (ver CLAUDE.md) - valores do enum Canal
  // reaproveitado, nao um enum novo. Nulo e nao lido/escrito por nenhum
  // codigo ainda nesta fatia.
  leadSourceChannel String?   @map("lead_source_channel") @db.VarChar(20)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author  User               @relation("SocialPostAuthor", fields: [authorId], references: [id])
  targets SocialPostTarget[]

  @@map("social_posts")
}

// Uma publicacao de um SocialPost numa SocialAccount especifica - 1
// registro por (post, conta), ja que o mesmo post pode ir para varias
// contas/plataformas. Sem tenantId proprio - isolamento vem via
// post.tenantId (mesmo padrao ja usado em SignatureField/SignatureEvent,
// que tambem alcancam o tenant so pela cadeia de relacionamento).
model SocialPostTarget {
  id              String    @id @default(uuid()) @db.Uuid
  postId          String    @map("post_id") @db.Uuid
  socialAccountId String    @map("social_account_id") @db.Uuid
  platformPostId  String?   @map("platform_post_id") @db.VarChar(255) // id retornado pela plataforma apos publicar
  status          String    @default("PENDING") @db.VarChar(20) // PENDING, PUBLISHED, FAILED
  errorMessage    String?   @map("error_message") @db.Text
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  post          SocialPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount      @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  metrics       SocialPostMetric[]

  @@map("social_post_targets")
}

// Uma coleta pontual de metricas de um SocialPostTarget - varios registros
// ao longo do tempo por target (serie historica), nao um snapshot unico
// sobrescrito. Sem tenantId proprio, mesmo raciocinio de SocialPostTarget.
model SocialPostMetric {
  id           String   @id @default(uuid()) @db.Uuid
  postTargetId String   @map("post_target_id") @db.Uuid
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  reach        Int      @default(0)
  impressions  Int      @default(0)
  collectedAt  DateTime @default(now()) @map("collected_at")

  postTarget SocialPostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)

  @@map("social_post_metrics")
}

// Midia reutilizavel (biblioteca de imagens/videos) para compor posts -
// independente de um SocialPost especifico (por isso sem postId), pode ser
// referenciada por varios posts atraves de mediaUrls. uploadedBy segue o
// mesmo padrao de FK opcional com onDelete: SetNull ja usado em Card.owner
// (o registro da midia sobrevive a exclusao do usuario que fez upload).
model SocialMediaAsset {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  url        String   @db.VarChar(500)
  type       String   @db.VarChar(20) // image, video
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader User?  @relation("SocialMediaAssetUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@map("social_media_assets")
}
