// prisma/schema.prisma
// Ecossistema: gestaodevendas
// Modulo: Base + Autenticacao (Fase 1 + Fase 2)

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Isolamento Multitenant: cada empresa cliente (imobiliaria) e um Tenant
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  // Dados da empresa (razao social = "name" acima, ja usado desde o
  // cadastro inicial) para qualificar o CONTRATANTE no contrato de
  // prestacao de servico (modulo rh, ver GerarContratoPrestacaoServicoUseCase)
  // e qualquer outro documento futuro que precise dos dados formais da
  // empresa. Preenchidos pelo Administrador em /dashboard/configuracoes
  // (modulo configuracoes) - nulos ate la, ja que nenhum tenant existente
  // tinha esses dados antes desta fatia.
  cnpj        String? @db.VarChar(20)
  endereco    String? @db.VarChar(200)
  numero      String? @db.VarChar(20)
  complemento String? @db.VarChar(100)
  bairro      String? @db.VarChar(100)
  cep         String? @db.VarChar(10)

  roles Role[]
  users User[]

  whatsAppSessions WhatsAppSession[]
  whatsAppMessages WhatsAppMessage[]

  pipelines  Pipeline[]
  stages     Stage[]
  cards      Card[]
  activities Activity[]
  notes      Note[]

  empreendimentos Empreendimento[]
  imoveis         Imovel[]
  imovelPhotos    ImovelPhoto[]

  proprietarios         Proprietario[]
  inquilinosCompradores InquilinoComprador[]
  contratos             Contrato[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  inquilinoDocumentos    InquilinoDocumento[]

  viviConversations ViviConversation[]

  filas        Fila[]
  atendimentos Atendimento[]

  roletaConfig RoletaConfig?
  viviConfig   ViviConfig?

  signatureEnvelopes SignatureEnvelope[]

  contratoTemplates ContratoTemplate[]

  @@map("tenants")
}

// Cargos customizaveis por empresa (Administrador, Vendedor, SDR, etc.)
model Role {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(50)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@map("roles")
}

// Usuarios do sistema, sempre vinculados a um Tenant e a um Role
model User {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  // Presenca do usuario para o modulo RH/Equipe: "online", "ausente" ou
  // "offline". Atualizado pelo proprio usuario (seletor na Topbar) ou
  // automaticamente para "online" no login.
  statusDisponibilidade String @default("offline") @map("status_disponibilidade") @db.VarChar(10)

  // Modulo RH completo: cadastro publico multi-perfil + aprovacao.
  // "aprovado" e o default para nao travar contas ja existentes (criadas
  // por Administrador ou pelo seed) - so o PublicSignupUseCase grava
  // "pendente_aprovacao" explicitamente. Valores: pendente_aprovacao,
  // aprovado, rejeitado.
  statusCadastro String  @default("aprovado") @map("status_cadastro") @db.VarChar(20)
  telefone       String? @db.VarChar(30)
  cpf            String? @db.VarChar(20)
  // Corretor House / Corretor Parceiro.
  creci          String? @db.VarChar(30)
  // Imobiliaria Parceira.
  nomeImobiliaria String? @map("nome_imobiliaria") @db.VarChar(150)
  cnpj            String? @db.VarChar(20)
  creciJ          String? @map("creci_j") @db.VarChar(30)
  cargoNaEmpresa  String? @map("cargo_na_empresa") @db.VarChar(100)
  // Hierarquia (House / Imobiliaria Parceira), preenchida na aprovacao.
  cargoHierarquico String? @map("cargo_hierarquico") @db.VarChar(30)
  superiorId       String? @map("superior_id") @db.Uuid
  // So relevante quando o Role for Cliente: comprador, proprietario ou ambos.
  tipoCliente String? @map("tipo_cliente") @db.VarChar(20)
  cep         String? @db.VarChar(10)
  endereco    String? @db.VarChar(200)

  // Contrato de prestacao de servico gerado automaticamente na aprovacao
  // (modulo rh, ver GerarContratoPrestacaoServicoUseCase) - nulo ate a
  // aprovacao acontecer, ou se o roleName nao exigir contrato (ex:
  // Cliente). Rastreamento visivel na tela de Aprovacoes (aba "Aprovados").
  contratoPrestacaoServicoEnvelopeId String? @unique @map("contrato_prestacao_servico_envelope_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])
  superior      User?  @relation("UserHierarchy", fields: [superiorId], references: [id], onDelete: SetNull)
  subordinados  User[] @relation("UserHierarchy")
  contratoPrestacaoServicoEnvelope SignatureEnvelope? @relation("UserContratoPrestacaoServico", fields: [contratoPrestacaoServicoEnvelopeId], references: [id], onDelete: SetNull)

  passwordResetTokens PasswordResetToken[]
  twoFactorCodes      TwoFactorCode[]
  whatsAppSessions    WhatsAppSession[]
  ownedCards          Card[]
  // Cards onde este usuario e a sugestao pendente da Roleta Online
  // (modo semi_automatico) - ver CardSuggestedOwner em Card.
  suggestedCards      Card[] @relation("CardSuggestedOwner")
  createdSignatureEnvelopes SignatureEnvelope[]

  filaVinculos       FilaUsuario[]
  atendimentosDono   Atendimento[]
  atendimentoEventos AtendimentoEvento[]

  @@map("users")
}

// Modulo RH - geracao automatica de contrato de prestacao de servico.
// Texto do contrato com placeholders ({{NOME}}, {{CPF}}, etc, preenchidos
// por preencher-contrato-template.ts) guardado no banco (nao fixo no
// codigo) para permitir customizacao futura pelo Administrador. "padrao"
// marca qual template e usado automaticamente na aprovacao de um cadastro
// (GetOrCreateContratoTemplateUseCase cria um com texto generico na
// primeira vez que um tenant precisa, mesmo padrao ja usado para as filas
// padrao do modulo Atendimento) - nao e @@unique de proposito, para deixar
// aberto ter mais de um template por tenant no futuro (so 1 marcado como
// padrao por vez, mas isso nao e reforcado no banco ainda nesta fatia).
model ContratoTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String   @db.VarChar(150)
  corpo     String   @db.Text
  padrao    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("contrato_templates")
}

// Tokens de uso unico para o fluxo de "esqueci a senha"
model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Codigos de uso unico para o segundo fator de autenticacao (2FA) por e-mail
model TwoFactorCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_codes")
}

// Uma conexao de WhatsApp via QR Code (Baileys) pertencente a um Tenant,
// opcionalmente vinculada ao corretor/usuario dono do numero.
model WhatsAppSession {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  label       String   @db.VarChar(100)
  status      String   @default("PENDING_QR") @db.VarChar(20)
  phoneNumber String?  @map("phone_number") @db.VarChar(30)
  // Marca se esta sessao especifica e atendida pela VIVI (assistente de IA)
  // em vez do corretor humano dono do numero.
  isAiEnabled Boolean  @default(false) @map("is_ai_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner             User?              @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  messages          WhatsAppMessage[]
  viviConversations ViviConversation[]
  atendimentos      Atendimento[]

  @@map("whatsapp_sessions")
}

// Historico de mensagens trocadas em uma sessao de WhatsApp.
// Apenas armazenamento: nao dispara Card nem roteamento para SDR.
model WhatsAppMessage {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  direction  String   @db.VarChar(3) // "IN" ou "OUT"
  fromNumber String   @map("from_number") @db.VarChar(30)
  toNumber   String   @map("to_number") @db.VarChar(30)
  // JID completo do Baileys, com sufixo (@lid ou @s.whatsapp.net).
  // fromNumber/toNumber guardam so os digitos (exibicao); remoteJid e o
  // valor correto para RESPONDER - numeros @lid nao sao um MSISDN valido
  // sob @s.whatsapp.net, entao reconstruir o JID a partir dos digitos
  // quebra o envio. Nulo em mensagens antigas, anteriores a essa correcao.
  remoteJid  String?  @map("remote_jid") @db.VarChar(50)
  body       String   @db.Text
  timestamp  DateTime
  createdAt  DateTime @default(now()) @map("created_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("whatsapp_messages")
}

// Uma conversa da VIVI (assistente SDR de IA) com um lead via WhatsApp.
// Guarda o que ja foi coletado do lead e o status do atendimento. Quando
// a VIVI decide transferir para um corretor humano, cardId e preenchido
// com o Card criado na Caixa de Entrada (origem "roleta_online").
model ViviConversation {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  whatsappSessionId   String   @map("whatsapp_session_id") @db.Uuid
  phoneNumber         String   @map("phone_number") @db.VarChar(30)
  status              String   @default("em_andamento") @db.VarChar(30)
  nomeColetado        String?  @map("nome_coletado") @db.VarChar(150)
  tipoImovelColetado  String?  @map("tipo_imovel_coletado") @db.VarChar(50)
  orcamentoColetado   String?  @map("orcamento_coletado") @db.VarChar(100)
  regiaoColetado      String?  @map("regiao_coletado") @db.VarChar(150)
  finalidadeColetado  String?  @map("finalidade_coletado") @db.VarChar(20)
  cardId              String?  @map("card_id") @db.Uuid
  // Preenchido quando a tool "agendar_visita" e chamada - a meta absoluta
  // da VIVI (ver constants/vivi-prompt.ts). Diferente de qualificado_
  // transferido/encaminhado_fila, agendar uma visita NAO encerra a
  // conversa (status continua "em_andamento") - a VIVI segue coletando
  // dados pos-visita (nascimento/email/tipo de renda/IR) depois disso.
  visitaAgendadaEm    DateTime? @map("visita_agendada_em")
  // Renda familiar mensal aproximada declarada pelo lead, e a categoria
  // habitacional resultante (HIS1/HIS2/HMP/R2V/SEM_PERFIL) - sempre
  // calculada em codigo puro (ver domain/services/classificar-renda.ts),
  // nunca decidida pela IA. Usada para o argumento de venda certo na
  // conversa.
  rendaDeclarada        Float?  @map("renda_declarada")
  categoriaHabitacional String? @map("categoria_habitacional") @db.VarChar(20)
  // Coletados SOMENTE apos visitaAgendadaEm ser preenchido (ver tool
  // "salvar_dados_pos_visita" - rejeitada em codigo se a visita ainda nao
  // foi confirmada, defesa em profundidade alem da ordem pedida no prompt).
  dataNascimento  String?  @map("data_nascimento") @db.VarChar(20)
  email           String?  @db.VarChar(150)
  tipoRenda       String?  @map("tipo_renda") @db.VarChar(20)
  fezDeclaracaoIR Boolean? @map("fez_declaracao_ir")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session WhatsAppSession @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)
  card    Card?           @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@map("vivi_conversations")
}

// Fila de atendimento (modulo Central de Atendimento) - agrupa
// atendimentos por categoria (ex: Suporte, Financeiro, Duvidas Gerais) e
// define quais agentes podem atende-los (ver FilaUsuario). Independente
// de Pipeline/Stage do Kanban - atendimento de suporte/duvida nao e um
// "negocio" no funil de vendas, por isso vive num modulo proprio.
model Fila {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String   @db.VarChar(100)
  descricao String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarios     FilaUsuario[]
  atendimentos Atendimento[]

  @@map("filas")
}

// Vinculo N:N entre agente (User) e Fila - so agentes vinculados podem
// assumir atendimentos daquela fila (Administrador sempre pode, mesmo sem
// vinculo - ver AssignAtendimentoUseCase).
model FilaUsuario {
  id        String   @id @default(uuid()) @db.Uuid
  filaId    String   @map("fila_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  fila Fila @relation(fields: [filaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([filaId, userId])
  @@map("fila_usuarios")
}

// Uma conversa de atendimento (Central de Atendimento) com um contato via
// WhatsApp - paralelo ao Card do Kanban, mas para suporte/duvidas em vez
// de negociacao de venda. Criado automaticamente
// (GetOrCreateAtendimentoUseCase) quando uma mensagem chega numa sessao
// SEM VIVI ativa, ou quando a propria VIVI decide que a duvida nao e de
// venda (tool "transferir_para_fila" - ver ProcessIncomingMessageUseCase
// no modulo vivi_sdr).
model Atendimento {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  whatsappSessionId String @map("whatsapp_session_id") @db.Uuid
  // JID completo (com sufixo @lid ou @s.whatsapp.net) - necessario para
  // responder corretamente (ver CLAUDE.md, bug do JID @lid).
  remoteJid   String @map("remote_jid") @db.VarChar(50)
  phoneNumber String @map("phone_number") @db.VarChar(30)
  // Nulo ate ser classificado manualmente (ClassifyAndRouteAtendimentoUseCase)
  // ou pela VIVI.
  filaId String? @map("fila_id") @db.Uuid
  // Nulo ate um agente assumir (AssignAtendimentoUseCase).
  ownerId String? @map("owner_id") @db.Uuid
  // aguardando -> em_atendimento -> fechado (ou devolvido para aguardando
  // via RequeueAtendimentoUseCase).
  status           String    @default("aguardando") @db.VarChar(20)
  motivoFechamento String?   @map("motivo_fechamento") @db.VarChar(300)
  // Marcado pela VIVI quando o lead pede explicitamente para falar com um
  // humano AGORA (ver ProcessIncomingMessageUseCase/vivi-prompt.ts) -
  // exibido como badge visual na Central de Atendimento.
  urgente          Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  closedAt         DateTime? @map("closed_at")

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session WhatsAppSession     @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)
  fila    Fila?               @relation(fields: [filaId], references: [id], onDelete: SetNull)
  owner   User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  eventos AtendimentoEvento[]

  @@map("atendimentos")
}

// Trilha de auditoria de um Atendimento - um evento por acao relevante
// (criado, atribuido, transferido, devolvido, fechado, nota).
model AtendimentoEvento {
  id            String   @id @default(uuid()) @db.Uuid
  atendimentoId String   @map("atendimento_id") @db.Uuid
  tipo          String   @db.VarChar(20)
  userId        String?  @map("user_id") @db.Uuid
  detalhe       String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("atendimento_eventos")
}

// Um funil de vendas (ex: "Vendas Imoveis"). Um tenant pode ter varios.
model Pipeline {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages Stage[]
  cards  Card[]

  @@map("pipelines")
}

// Uma coluna do Kanban dentro de um Pipeline. "position" e Float para
// permitir reordenar por arraste sem precisar reindexar as demais colunas.
model Stage {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  pipelineId String @map("pipeline_id") @db.Uuid
  name       String @db.VarChar(100)
  position   Float

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@map("stages")
}

// Um card (lead/oportunidade), sempre vinculado a um Pipeline. "stageId"
// e opcional: nulo significa que o card esta na Caixa de Entrada, ainda
// sem coluna e sem dono. "position" e Float pelo mesmo motivo do Stage
// (algoritmo de posicionamento flutuante).
model Card {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  pipelineId   String   @map("pipeline_id") @db.Uuid
  stageId      String?  @map("stage_id") @db.Uuid
  ownerId      String?  @map("owner_id") @db.Uuid
  // Sugestao da Roleta Online (modo semi_automatico): corretor sugerido
  // para assumir o lead, ainda sem confirmacao (ownerId continua nulo ate
  // ConfirmSuggestedOwnerUseCase ser chamado). Ver modulo roleta_online.
  suggestedOwnerId String? @map("suggested_owner_id") @db.Uuid
  imovelId     String?  @map("imovel_id") @db.Uuid
  title        String   @db.VarChar(200)
  value        Decimal  @default(0) @db.Decimal(12, 2)
  position     Float
  origem       String   @default("manual") @db.VarChar(20)
  phone        String?  @db.VarChar(30)
  temperatura  String?  @db.VarChar(10)
  email        String?  @db.VarChar(150)
  endereco     String?  @db.VarChar(200)
  numero       String?  @db.VarChar(20)
  complemento  String?  @db.VarChar(100)
  bairro       String?  @db.VarChar(100)
  cep          String?  @db.VarChar(10)
  // Resumo automatico legivel pelo corretor sem abrir outra tela - hoje so
  // preenchido pela VIVI (transferir_para_corretor/agendar_visita, ver
  // domain/services/build-resumo-atendimento.ts no modulo vivi_sdr), mas
  // disponivel para qualquer outro fluxo futuro que queira usa-lo.
  description  String?  @db.Text
  customFields Json     @default("{}") @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline          Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage             Stage?             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  owner             User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  suggestedOwner    User?              @relation("CardSuggestedOwner", fields: [suggestedOwnerId], references: [id], onDelete: SetNull)
  imovel            Imovel?            @relation(fields: [imovelId], references: [id], onDelete: SetNull)
  activities        Activity[]
  notes             Note[]
  viviConversations ViviConversation[]

  @@map("cards")
}

// Um empreendimento imobiliario (ex: um condominio) que agrupa varias
// unidades (Imovel). Opcional: um Imovel pode ser avulso, sem empreendimento.
model Empreendimento {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(150)
  rua         String   @db.VarChar(200)
  numero      String   @db.VarChar(20)
  bairro      String   @db.VarChar(100)
  cidade      String   @db.VarChar(100)
  uf          String   @db.VarChar(2)
  cep         String   @db.VarChar(10)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imoveis Imovel[]

  @@map("empreendimentos")
}

// Uma unidade/imovel disponivel para venda e/ou aluguel. Pode pertencer a
// um Empreendimento ou ser avulso (empreendimentoId nulo).
model Imovel {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  empreendimentoId      String?   @map("empreendimento_id") @db.Uuid
  title                 String    @db.VarChar(200)
  codigoInterno         String?   @map("codigo_interno") @db.VarChar(50)
  tipo                  String    @db.VarChar(20)
  uso                   String?   @db.VarChar(20)
  finalidade            String    @db.VarChar(10)
  tags                  String?   @db.Text
  price                 Decimal?  @db.Decimal(12, 2)
  rentPrice             Decimal?  @map("rent_price") @db.Decimal(12, 2)
  area                  Float?
  bedrooms              Int?
  bathrooms             Int?
  parkingSpots          Int?      @map("parking_spots")
  rua                   String?   @db.VarChar(200)
  numero                String?   @db.VarChar(20)
  complemento           String?   @db.VarChar(100)
  bairro                String?   @db.VarChar(100)
  cidade                String?   @db.VarChar(100)
  uf                    String?   @db.VarChar(2)
  cep                   String?   @db.VarChar(10)
  description           String?   @db.Text
  status                String    @default("disponivel") @db.VarChar(20)
  disponivelApartirDe   DateTime? @map("disponivel_a_partir_de")
  localChaves           String?   @map("local_chaves") @db.VarChar(20)
  exclusividade         Boolean   @default(false)
  proprietarioNome      String?   @map("proprietario_nome") @db.VarChar(150)
  proprietarioTelefone  String?   @map("proprietario_telefone") @db.VarChar(30)
  customFields          Json      @default("{}") @map("custom_fields")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empreendimento Empreendimento? @relation(fields: [empreendimentoId], references: [id], onDelete: SetNull)
  photos         ImovelPhoto[]
  cards          Card[]
  contratos      Contrato[]

  @@map("imoveis")
}

// Uma foto de um Imovel, ordenavel na vitrine (order).
model ImovelPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  imovelId  String   @map("imovel_id") @db.Uuid
  url       String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("imovel_photos")
}

// Dono de um imovel (vendedor/locador). Vinculado ao Imovel apenas atraves
// do Contrato (imovel.proprietarioNome/proprietarioTelefone continuam sendo
// campos simples, sem FK - ver CLAUDE.md sobre a futura entidade formal do
// modulo RH/Cadastros).
model Proprietario {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nome          String   @db.VarChar(150)
  cpfCnpj       String?  @map("cpf_cnpj") @db.VarChar(20)
  telefone      String   @db.VarChar(30)
  email         String?  @db.VarChar(150)
  rua           String?  @db.VarChar(200)
  numero        String?  @db.VarChar(20)
  complemento   String?  @db.VarChar(100)
  bairro        String?  @db.VarChar(100)
  cidade        String?  @db.VarChar(100)
  uf            String?  @db.VarChar(2)
  cep           String?  @db.VarChar(10)
  // Dados bancarios para repasse financeiro futuro (aluguel, venda).
  banco         String?  @db.VarChar(100)
  agencia       String?  @db.VarChar(20)
  conta         String?  @db.VarChar(20)
  pix           String?  @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratos Contrato[]

  @@map("proprietarios")
}

// Quem compra ou aluga um imovel. Fatia 5 (Moradores/Inquilinos) adicionou
// analise de credito (profissao/renda/status/observacoes) e documentos
// anexados (InquilinoDocumento).
model InquilinoComprador {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String   @db.VarChar(150)
  cpfCnpj   String?  @map("cpf_cnpj") @db.VarChar(20)
  telefone  String   @db.VarChar(30)
  email     String?  @db.VarChar(150)
  profissao String?  @db.VarChar(100)
  rendaDeclarada Decimal? @map("renda_declarada") @db.Decimal(12, 2)
  // nao_iniciada, em_analise, aprovado, reprovado.
  statusAnaliseCredito String  @default("nao_iniciada") @map("status_analise_credito") @db.VarChar(20)
  observacoesAnalise   String? @map("observacoes_analise") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratos  Contrato[]
  documentos InquilinoDocumento[]

  @@map("inquilinos_compradores")
}

// Um documento anexado a analise de credito de um InquilinoComprador (RG/CPF,
// comprovante de renda, comprovante de residencia, outro). Mesmo padrao de
// armazenamento ja usado para fotos de imovel e documentos do E-doc
// (IFileStorageService, trocavel).
model InquilinoDocumento {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  inquilinoId String   @map("inquilino_id") @db.Uuid
  // rg_cpf, comprovante_renda, comprovante_residencia, outro.
  tipo        String   @db.VarChar(30)
  url         String   @db.VarChar(500)
  nomeArquivo String   @map("nome_arquivo") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inquilino InquilinoComprador @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)

  @@map("inquilino_documentos")
}

// Contrato de venda ou locacao, ligando um Imovel a um Proprietario e a um
// InquilinoComprador. Ao criar, o Imovel.status muda automaticamente
// (vendido/ocupado); ao encerrar, volta (disponivel/vago) - ver
// CreateContratoUseCase / EncerrarContratoUseCase.
model Contrato {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  imovelId             String    @map("imovel_id") @db.Uuid
  proprietarioId       String    @map("proprietario_id") @db.Uuid
  inquilinoCompradorId String    @map("inquilino_comprador_id") @db.Uuid
  tipo                 String    @db.VarChar(10) // "venda" ou "locacao"
  valor                Decimal   @db.Decimal(12, 2)
  dataInicio           DateTime  @map("data_inicio")
  // Opcional - usado em locacao (fim do contrato); venda pode deixar nulo
  // ou usar como data de conclusao.
  dataFim              DateTime? @map("data_fim")
  // Dia do mes para vencimento do aluguel - so relevante em locacao.
  diaVencimento        Int?      @map("dia_vencimento")
  status               String    @default("ativo") @db.VarChar(20) // ativo, encerrado, cancelado
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imovel             Imovel             @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  proprietario       Proprietario       @relation(fields: [proprietarioId], references: [id], onDelete: Cascade)
  inquilinoComprador InquilinoComprador @relation(fields: [inquilinoCompradorId], references: [id], onDelete: Cascade)
  lancamentosFinanceiros LancamentoFinanceiro[]

  @@map("contratos")
}

// Modulo Financeiro (Fatia 4 da Gestao Imobiliaria). Um lancamento pode ser
// manual/avulso (contratoId nulo) ou gerado automaticamente a partir de um
// Contrato de locacao (GerarCobrancasDoMesUseCase, categoria "aluguel").
// "receita" = a receber do inquilino/comprador; "repasse" = a pagar ao
// proprietario (ex: repasse de aluguel apos descontar taxa de administracao).
model LancamentoFinanceiro {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  contratoId String?   @map("contrato_id") @db.Uuid
  tipo       String    @db.VarChar(10) // "receita" ou "repasse"
  categoria  String    @db.VarChar(30) // aluguel, venda, taxa_administracao, manutencao, outro
  valor      Decimal   @db.Decimal(12, 2)
  vencimento DateTime
  status     String    @default("pendente") @db.VarChar(20) // pendente, pago, atrasado
  pagoEm     DateTime? @map("pago_em")
  descricao  String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contrato Contrato? @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@map("lancamentos_financeiros")
}

// Uma atividade agendada/registrada para um card (ligacao, reuniao, visita,
// tarefa, proposta). "done" marca se ja foi concluida.
model Activity {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  cardId      String    @map("card_id") @db.Uuid
  type        String    @db.VarChar(20)
  subject     String?   @db.VarChar(200)
  scheduledAt DateTime? @map("scheduled_at")
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("activities")
}

// Uma anotacao de texto livre associada a um card.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("notes")
}

// Configuracao da Roleta Online (distribuicao automatica de leads sem dono
// entre corretores online) - uma unica config por tenant. ultimoCorretorId
// e um ponteiro simples (sem FK) usado pelo algoritmo round_robin para saber
// quem foi o ultimo a receber um lead.
model RoletaConfig {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  algoritmo        String   @default("round_robin") @db.VarChar(20) // "round_robin" ou "menor_fila"
  modo             String   @default("semi_automatico") @db.VarChar(20) // "automatico" ou "semi_automatico"
  ativa            Boolean  @default(false)
  ultimoCorretorId String?  @map("ultimo_corretor_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("roleta_configs")
}

// Configuracao de negocio da VIVI (assistente SDR de IA) - uma unica config
// por tenant. Preco minimo e as 4 faixas de renda (SEM_PERFIL/HIS1/HIS2/
// HMP - acima de limiteHmp e R2V) sao interpolados no system prompt (ver
// buildViviSystemPrompt) E usados por classificarRenda() para a
// classificacao autoritativa - as duas fontes leem os mesmos valores desta
// tabela, nunca hardcoded. Get-or-create com os defaults abaixo na
// primeira leitura (mesmo padrao ja usado por ContratoTemplate/RoletaConfig).
model ViviConfig {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  precoMinimo     Decimal  @default(264000) @map("preco_minimo") @db.Decimal(12, 2)
  limiteSemPerfil Decimal  @default(1500) @map("limite_sem_perfil") @db.Decimal(12, 2)
  limiteHis1      Decimal  @default(2850) @map("limite_his1") @db.Decimal(12, 2)
  limiteHis2      Decimal  @default(4700) @map("limite_his2") @db.Decimal(12, 2)
  limiteHmp       Decimal  @default(8000) @map("limite_hmp") @db.Decimal(12, 2)
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("vivi_configs")
}

// Modulo E-doc (assinatura eletronica). Um envelope agrupa um documento
// (PDF) e a lista de destinatarios que precisam assina-lo, em ordem
// sequencial estrita (so o proximo recebe o link depois que o anterior
// assinar). Fatia 2 adicionou o editor de posicionamento (SignatureField)
// e signedDocumentUrl (o PDF final com as assinaturas embutidas).
model SignatureEnvelope {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  title           String    @db.VarChar(200)
  // rascunho -> aguardando_assinaturas -> concluido (ou cancelado a qualquer momento antes de concluido).
  status          String    @default("rascunho") @db.VarChar(30)
  documentUrl     String    @map("document_url") @db.VarChar(500)
  // SHA-256 do PDF original, calculado na criacao - prova de integridade do documento.
  documentHash    String    @map("document_hash") @db.VarChar(64)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  // PDF final com as assinaturas embutidas (pdf-lib) - preenchido pelo
  // GenerateSignedPdfUseCase logo apos o envelope ficar "concluido".
  // Nulo ate la (e continua nulo se a geracao falhar - ver CLAUDE.md).
  signedDocumentUrl String? @map("signed_document_url") @db.VarChar(500)
  // Assunto/mensagem customizaveis do e-mail de convite (Fatia 4) - nulos
  // se o usuario nao customizar, e o SendEnvelopeUseCase aplica o template
  // padrao definido em domain/services/envelope-validation.ts nesse caso
  // (default aplicado na camada de aplicacao, nao aqui no schema).
  emailSubject    String?   @map("email_subject") @db.VarChar(200)
  emailMessage    String?   @map("email_message") @db.Text

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User                 @relation(fields: [createdByUserId], references: [id])
  // Relacao reversa do FK opcional em User.contratoPrestacaoServicoEnvelopeId
  // (modulo rh) - o corretor/parceiro para quem este envelope especifico e
  // o contrato de prestacao de servico (se for esse o caso).
  usuarioContratado User? @relation("UserContratoPrestacaoServico")
  recipients SignatureRecipient[]
  events     SignatureEvent[]
  fields     SignatureField[]

  @@map("signature_envelopes")
}

// Um destinatario/signatario de um envelope. accessToken/tokenExpiresAt
// ficam nulos enquanto o envelope esta em "rascunho" - so sao gerados pelo
// SendEnvelopeUseCase, um por destinatario, no momento do envio (ver
// CLAUDE.md para a decisao sobre essa nulidade). Sem tenantId proprio de
// proposito: as rotas publicas (/edoc/sign/:token) nao tem contexto de
// tenant - o token e a propria fronteira de seguranca, e o acesso
// autenticado sempre passa pelo SignatureEnvelope (que ja e tenant-scoped)
// primeiro - mesmo padrao ja usado em PasswordResetToken/TwoFactorCode.
model SignatureRecipient {
  id                 String    @id @default(uuid()) @db.Uuid
  envelopeId         String    @map("envelope_id") @db.Uuid
  name               String    @db.VarChar(150)
  email              String    @db.VarChar(150)
  // Grupo de assinatura (Fatia 3): destinatario, remetente ou testemunha -
  // define tanto a cor/UI do participante quanto a ordem de ENVIO por
  // grupo (todos os destinatarios assinam, depois todos os remetentes,
  // depois todas as testemunhas - ver sortBySignatureSequence no dominio).
  role               String    @default("destinatario") @db.VarChar(20)
  // Ordem sequencial de assinatura DENTRO DO PROPRIO GRUPO de "role"
  // (Fatia 3) - comecando em 1 em cada grupo, nao mais uma ordem global
  // entre todos os participantes do envelope.
  order              Int
  accessToken        String?   @unique @map("access_token") @db.VarChar(255)
  tokenExpiresAt     DateTime? @map("token_expires_at")
  status             String    @default("pendente") @db.VarChar(20)
  signedAt           DateTime? @map("signed_at")
  // Base64 do canvas (data URL) OU o nome digitado, conforme o metodo escolhido na tela de assinatura.
  signatureImageData String?   @map("signature_image_data") @db.Text
  // SHA-256 do conteudo de signatureImageData.
  signatureHash      String?   @map("signature_hash") @db.VarChar(64)
  signerIp           String?   @map("signer_ip") @db.VarChar(45)
  signerUserAgent    String?   @map("signer_user_agent") @db.VarChar(500)

  envelope SignatureEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  events   SignatureEvent[]
  fields   SignatureField[]

  @@map("signature_recipients")
}

// Campo de assinatura posicionado sobre o PDF (Fatia 2) - por enquanto
// sempre 1 por destinatario, criado junto com o envelope
// (CreateEnvelopeUseCase). x/y/width/height sao percentuais (0-1)
// relativos ao tamanho da pagina, nao pixels absolutos - funciona em
// qualquer resolucao de tela ou tamanho real de pagina do PDF.
model SignatureField {
  id             String   @id @default(uuid()) @db.Uuid
  envelopeId     String   @map("envelope_id") @db.Uuid
  recipientId    String   @map("recipient_id") @db.Uuid
  // assinatura (padrao, tipicamente so na ultima pagina) ou rubrica
  // (Fatia 3, repetida em todas as paginas) - a repeticao em si e
  // responsabilidade do FRONTEND (gera 1 SignatureField por pagina com o
  // mesmo recipientId e tipo="rubrica" quando o usuario posiciona 1 vez);
  // o backend so recebe e salva a lista final de campos.
  tipo           String   @default("assinatura") @db.VarChar(20)
  pageNumber     Int      @map("page_number")
  xPercent       Float    @map("x_percent")
  yPercent       Float    @map("y_percent")
  widthPercent   Float    @default(0.2) @map("width_percent")
  heightPercent  Float    @default(0.08) @map("height_percent")
  createdAt      DateTime @default(now()) @map("created_at")

  envelope  SignatureEnvelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipient SignatureRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("signature_fields")
}

// Trilha de auditoria do envelope - um evento por acao relevante (criado,
// enviado, visualizado, assinado, concluido, cancelado), com IP/User-Agent
// quando aplicavel (visualizado/assinado, vindos da rota publica).
model SignatureEvent {
  id          String   @id @default(uuid()) @db.Uuid
  envelopeId  String   @map("envelope_id") @db.Uuid
  recipientId String?  @map("recipient_id") @db.Uuid
  type        String   @db.VarChar(30)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  envelope  SignatureEnvelope   @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipient SignatureRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@map("signature_events")
}
