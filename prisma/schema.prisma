// prisma/schema.prisma
// Ecossistema: gestaodevendas
// Modulo: Base + Autenticacao (Fase 1 + Fase 2)

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Isolamento Multitenant: cada empresa cliente (imobiliaria) e um Tenant
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  roles Role[]
  users User[]

  whatsAppSessions WhatsAppSession[]
  whatsAppMessages WhatsAppMessage[]

  pipelines  Pipeline[]
  stages     Stage[]
  cards      Card[]
  activities Activity[]
  notes      Note[]

  empreendimentos Empreendimento[]
  imoveis         Imovel[]
  imovelPhotos    ImovelPhoto[]

  proprietarios         Proprietario[]
  inquilinosCompradores InquilinoComprador[]
  contratos             Contrato[]

  viviConversations ViviConversation[]

  roletaConfig RoletaConfig?

  @@map("tenants")
}

// Cargos customizaveis por empresa (Administrador, Vendedor, SDR, etc.)
model Role {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(50)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@map("roles")
}

// Usuarios do sistema, sempre vinculados a um Tenant e a um Role
model User {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  // Presenca do usuario para o modulo RH/Equipe: "online", "ausente" ou
  // "offline". Atualizado pelo proprio usuario (seletor na Topbar) ou
  // automaticamente para "online" no login.
  statusDisponibilidade String @default("offline") @map("status_disponibilidade") @db.VarChar(10)

  // Modulo RH completo: cadastro publico multi-perfil + aprovacao.
  // "aprovado" e o default para nao travar contas ja existentes (criadas
  // por Administrador ou pelo seed) - so o PublicSignupUseCase grava
  // "pendente_aprovacao" explicitamente. Valores: pendente_aprovacao,
  // aprovado, rejeitado.
  statusCadastro String  @default("aprovado") @map("status_cadastro") @db.VarChar(20)
  telefone       String? @db.VarChar(30)
  cpf            String? @db.VarChar(20)
  // Corretor House / Corretor Parceiro.
  creci          String? @db.VarChar(30)
  // Imobiliaria Parceira.
  nomeImobiliaria String? @map("nome_imobiliaria") @db.VarChar(150)
  cnpj            String? @db.VarChar(20)
  creciJ          String? @map("creci_j") @db.VarChar(30)
  cargoNaEmpresa  String? @map("cargo_na_empresa") @db.VarChar(100)
  // Hierarquia (House / Imobiliaria Parceira), preenchida na aprovacao.
  cargoHierarquico String? @map("cargo_hierarquico") @db.VarChar(30)
  superiorId       String? @map("superior_id") @db.Uuid
  // So relevante quando o Role for Cliente: comprador, proprietario ou ambos.
  tipoCliente String? @map("tipo_cliente") @db.VarChar(20)
  cep         String? @db.VarChar(10)
  endereco    String? @db.VarChar(200)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])
  superior      User?  @relation("UserHierarchy", fields: [superiorId], references: [id], onDelete: SetNull)
  subordinados  User[] @relation("UserHierarchy")

  passwordResetTokens PasswordResetToken[]
  twoFactorCodes      TwoFactorCode[]
  whatsAppSessions    WhatsAppSession[]
  ownedCards          Card[]
  // Cards onde este usuario e a sugestao pendente da Roleta Online
  // (modo semi_automatico) - ver CardSuggestedOwner em Card.
  suggestedCards      Card[] @relation("CardSuggestedOwner")

  @@map("users")
}

// Tokens de uso unico para o fluxo de "esqueci a senha"
model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Codigos de uso unico para o segundo fator de autenticacao (2FA) por e-mail
model TwoFactorCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_codes")
}

// Uma conexao de WhatsApp via QR Code (Baileys) pertencente a um Tenant,
// opcionalmente vinculada ao corretor/usuario dono do numero.
model WhatsAppSession {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  label       String   @db.VarChar(100)
  status      String   @default("PENDING_QR") @db.VarChar(20)
  phoneNumber String?  @map("phone_number") @db.VarChar(30)
  // Marca se esta sessao especifica e atendida pela VIVI (assistente de IA)
  // em vez do corretor humano dono do numero.
  isAiEnabled Boolean  @default(false) @map("is_ai_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner             User?              @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  messages          WhatsAppMessage[]
  viviConversations ViviConversation[]

  @@map("whatsapp_sessions")
}

// Historico de mensagens trocadas em uma sessao de WhatsApp.
// Apenas armazenamento: nao dispara Card nem roteamento para SDR.
model WhatsAppMessage {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  direction  String   @db.VarChar(3) // "IN" ou "OUT"
  fromNumber String   @map("from_number") @db.VarChar(30)
  toNumber   String   @map("to_number") @db.VarChar(30)
  // JID completo do Baileys, com sufixo (@lid ou @s.whatsapp.net).
  // fromNumber/toNumber guardam so os digitos (exibicao); remoteJid e o
  // valor correto para RESPONDER - numeros @lid nao sao um MSISDN valido
  // sob @s.whatsapp.net, entao reconstruir o JID a partir dos digitos
  // quebra o envio. Nulo em mensagens antigas, anteriores a essa correcao.
  remoteJid  String?  @map("remote_jid") @db.VarChar(50)
  body       String   @db.Text
  timestamp  DateTime
  createdAt  DateTime @default(now()) @map("created_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("whatsapp_messages")
}

// Uma conversa da VIVI (assistente SDR de IA) com um lead via WhatsApp.
// Guarda o que ja foi coletado do lead e o status do atendimento. Quando
// a VIVI decide transferir para um corretor humano, cardId e preenchido
// com o Card criado na Caixa de Entrada (origem "roleta_online").
model ViviConversation {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  whatsappSessionId   String   @map("whatsapp_session_id") @db.Uuid
  phoneNumber         String   @map("phone_number") @db.VarChar(30)
  status              String   @default("em_andamento") @db.VarChar(30)
  nomeColetado        String?  @map("nome_coletado") @db.VarChar(150)
  tipoImovelColetado  String?  @map("tipo_imovel_coletado") @db.VarChar(50)
  orcamentoColetado   String?  @map("orcamento_coletado") @db.VarChar(100)
  regiaoColetado      String?  @map("regiao_coletado") @db.VarChar(150)
  finalidadeColetado  String?  @map("finalidade_coletado") @db.VarChar(20)
  cardId              String?  @map("card_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session WhatsAppSession @relation(fields: [whatsappSessionId], references: [id], onDelete: Cascade)
  card    Card?           @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@map("vivi_conversations")
}

// Um funil de vendas (ex: "Vendas Imoveis"). Um tenant pode ter varios.
model Pipeline {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages Stage[]
  cards  Card[]

  @@map("pipelines")
}

// Uma coluna do Kanban dentro de um Pipeline. "position" e Float para
// permitir reordenar por arraste sem precisar reindexar as demais colunas.
model Stage {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  pipelineId String @map("pipeline_id") @db.Uuid
  name       String @db.VarChar(100)
  position   Float

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@map("stages")
}

// Um card (lead/oportunidade), sempre vinculado a um Pipeline. "stageId"
// e opcional: nulo significa que o card esta na Caixa de Entrada, ainda
// sem coluna e sem dono. "position" e Float pelo mesmo motivo do Stage
// (algoritmo de posicionamento flutuante).
model Card {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  pipelineId   String   @map("pipeline_id") @db.Uuid
  stageId      String?  @map("stage_id") @db.Uuid
  ownerId      String?  @map("owner_id") @db.Uuid
  // Sugestao da Roleta Online (modo semi_automatico): corretor sugerido
  // para assumir o lead, ainda sem confirmacao (ownerId continua nulo ate
  // ConfirmSuggestedOwnerUseCase ser chamado). Ver modulo roleta_online.
  suggestedOwnerId String? @map("suggested_owner_id") @db.Uuid
  imovelId     String?  @map("imovel_id") @db.Uuid
  title        String   @db.VarChar(200)
  value        Decimal  @default(0) @db.Decimal(12, 2)
  position     Float
  origem       String   @default("manual") @db.VarChar(20)
  phone        String?  @db.VarChar(30)
  temperatura  String?  @db.VarChar(10)
  email        String?  @db.VarChar(150)
  endereco     String?  @db.VarChar(200)
  numero       String?  @db.VarChar(20)
  complemento  String?  @db.VarChar(100)
  bairro       String?  @db.VarChar(100)
  cep          String?  @db.VarChar(10)
  customFields Json     @default("{}") @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline          Pipeline           @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage             Stage?             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  owner             User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  suggestedOwner    User?              @relation("CardSuggestedOwner", fields: [suggestedOwnerId], references: [id], onDelete: SetNull)
  imovel            Imovel?            @relation(fields: [imovelId], references: [id], onDelete: SetNull)
  activities        Activity[]
  notes             Note[]
  viviConversations ViviConversation[]

  @@map("cards")
}

// Um empreendimento imobiliario (ex: um condominio) que agrupa varias
// unidades (Imovel). Opcional: um Imovel pode ser avulso, sem empreendimento.
model Empreendimento {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(150)
  rua         String   @db.VarChar(200)
  numero      String   @db.VarChar(20)
  bairro      String   @db.VarChar(100)
  cidade      String   @db.VarChar(100)
  uf          String   @db.VarChar(2)
  cep         String   @db.VarChar(10)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imoveis Imovel[]

  @@map("empreendimentos")
}

// Uma unidade/imovel disponivel para venda e/ou aluguel. Pode pertencer a
// um Empreendimento ou ser avulso (empreendimentoId nulo).
model Imovel {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  empreendimentoId      String?   @map("empreendimento_id") @db.Uuid
  title                 String    @db.VarChar(200)
  codigoInterno         String?   @map("codigo_interno") @db.VarChar(50)
  tipo                  String    @db.VarChar(20)
  uso                   String?   @db.VarChar(20)
  finalidade            String    @db.VarChar(10)
  tags                  String?   @db.Text
  price                 Decimal?  @db.Decimal(12, 2)
  rentPrice             Decimal?  @map("rent_price") @db.Decimal(12, 2)
  area                  Float?
  bedrooms              Int?
  bathrooms             Int?
  parkingSpots          Int?      @map("parking_spots")
  rua                   String?   @db.VarChar(200)
  numero                String?   @db.VarChar(20)
  complemento           String?   @db.VarChar(100)
  bairro                String?   @db.VarChar(100)
  cidade                String?   @db.VarChar(100)
  uf                    String?   @db.VarChar(2)
  cep                   String?   @db.VarChar(10)
  description           String?   @db.Text
  status                String    @default("disponivel") @db.VarChar(20)
  disponivelApartirDe   DateTime? @map("disponivel_a_partir_de")
  localChaves           String?   @map("local_chaves") @db.VarChar(20)
  exclusividade         Boolean   @default(false)
  proprietarioNome      String?   @map("proprietario_nome") @db.VarChar(150)
  proprietarioTelefone  String?   @map("proprietario_telefone") @db.VarChar(30)
  customFields          Json      @default("{}") @map("custom_fields")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empreendimento Empreendimento? @relation(fields: [empreendimentoId], references: [id], onDelete: SetNull)
  photos         ImovelPhoto[]
  cards          Card[]
  contratos      Contrato[]

  @@map("imoveis")
}

// Uma foto de um Imovel, ordenavel na vitrine (order).
model ImovelPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  imovelId  String   @map("imovel_id") @db.Uuid
  url       String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("imovel_photos")
}

// Dono de um imovel (vendedor/locador). Vinculado ao Imovel apenas atraves
// do Contrato (imovel.proprietarioNome/proprietarioTelefone continuam sendo
// campos simples, sem FK - ver CLAUDE.md sobre a futura entidade formal do
// modulo RH/Cadastros).
model Proprietario {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nome          String   @db.VarChar(150)
  cpfCnpj       String?  @map("cpf_cnpj") @db.VarChar(20)
  telefone      String   @db.VarChar(30)
  email         String?  @db.VarChar(150)
  rua           String?  @db.VarChar(200)
  numero        String?  @db.VarChar(20)
  complemento   String?  @db.VarChar(100)
  bairro        String?  @db.VarChar(100)
  cidade        String?  @db.VarChar(100)
  uf            String?  @db.VarChar(2)
  cep           String?  @db.VarChar(10)
  // Dados bancarios para repasse financeiro futuro (aluguel, venda).
  banco         String?  @db.VarChar(100)
  agencia       String?  @db.VarChar(20)
  conta         String?  @db.VarChar(20)
  pix           String?  @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratos Contrato[]

  @@map("proprietarios")
}

// Quem compra ou aluga um imovel. Entidade enxuta por agora - sera
// expandida (historico, analise de credito) quando a Fatia 5 (Moradores/
// Inquilinos) for construida formalmente.
model InquilinoComprador {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String   @db.VarChar(150)
  cpfCnpj   String?  @map("cpf_cnpj") @db.VarChar(20)
  telefone  String   @db.VarChar(30)
  email     String?  @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contratos Contrato[]

  @@map("inquilinos_compradores")
}

// Contrato de venda ou locacao, ligando um Imovel a um Proprietario e a um
// InquilinoComprador. Ao criar, o Imovel.status muda automaticamente
// (vendido/ocupado); ao encerrar, volta (disponivel/vago) - ver
// CreateContratoUseCase / EncerrarContratoUseCase.
model Contrato {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  imovelId             String    @map("imovel_id") @db.Uuid
  proprietarioId       String    @map("proprietario_id") @db.Uuid
  inquilinoCompradorId String    @map("inquilino_comprador_id") @db.Uuid
  tipo                 String    @db.VarChar(10) // "venda" ou "locacao"
  valor                Decimal   @db.Decimal(12, 2)
  dataInicio           DateTime  @map("data_inicio")
  // Opcional - usado em locacao (fim do contrato); venda pode deixar nulo
  // ou usar como data de conclusao.
  dataFim              DateTime? @map("data_fim")
  // Dia do mes para vencimento do aluguel - so relevante em locacao.
  diaVencimento        Int?      @map("dia_vencimento")
  status               String    @default("ativo") @db.VarChar(20) // ativo, encerrado, cancelado
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  imovel             Imovel             @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  proprietario       Proprietario       @relation(fields: [proprietarioId], references: [id], onDelete: Cascade)
  inquilinoComprador InquilinoComprador @relation(fields: [inquilinoCompradorId], references: [id], onDelete: Cascade)

  @@map("contratos")
}

// Uma atividade agendada/registrada para um card (ligacao, reuniao, visita,
// tarefa, proposta). "done" marca se ja foi concluida.
model Activity {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  cardId      String    @map("card_id") @db.Uuid
  type        String    @db.VarChar(20)
  subject     String?   @db.VarChar(200)
  scheduledAt DateTime? @map("scheduled_at")
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("activities")
}

// Uma anotacao de texto livre associada a um card.
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("notes")
}

// Configuracao da Roleta Online (distribuicao automatica de leads sem dono
// entre corretores online) - uma unica config por tenant. ultimoCorretorId
// e um ponteiro simples (sem FK) usado pelo algoritmo round_robin para saber
// quem foi o ultimo a receber um lead.
model RoletaConfig {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  algoritmo        String   @default("round_robin") @db.VarChar(20) // "round_robin" ou "menor_fila"
  modo             String   @default("semi_automatico") @db.VarChar(20) // "automatico" ou "semi_automatico"
  ativa            Boolean  @default(false)
  ultimoCorretorId String?  @map("ultimo_corretor_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("roleta_configs")
}
