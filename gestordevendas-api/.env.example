# =============================================================================
# Gestor de Vendas CRM — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o .env no repositório (está no .gitignore).
# =============================================================================


# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                  # development | production
DEBUG=false                          # true em desenvolvimento para logs extras
APP_SECRET_KEY=change-me-in-production-minimum-32-chars
API_PREFIX=/api


# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# CORS: domínios autorizados a chamar a API (separados por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,https://gestordevendas.com.br


# ─── Supabase ─────────────────────────────────────────────────────────────────
# Painel: supabase.com -> Settings -> API
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ⚠ SERVICE ROLE KEY — SOMENTE no backend. NUNCA expor no frontend/browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Painel: Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret


# ─── Redis / Celery ───────────────────────────────────────────────────────────
# Docker Compose: redis://redis:6379/0
# Local sem Docker: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0


# ─── Criptografia de segredos (chaves IA e tokens WhatsApp) ───────────────────
# ⚠ OBRIGATÓRIO. Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar esta chave invalida TODOS os segredos criptografados no banco.
ENCRYPTION_KEY=your-fernet-key-base64-here


# ─── Meta Cloud API (WhatsApp Business) ───────────────────────────────────────
# Painel: developers.facebook.com -> Seu App -> Settings -> Basic -> App Secret
META_APP_SECRET=your-meta-app-secret
META_API_VERSION=v21.0
# META_API_BASE_URL=https://graph.facebook.com  # padrão, raramente muda

# Nota: o verify_token do webhook é configurado POR INBOX no banco de dados
# (campo webhook_verify_token na tabela inboxes) — não é uma variável global.


# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Criar em: resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@gestordevendas.com.br


# ─── Stripe (Billing / SaaS) ──────────────────────────────────────────────────
# Painel: dashboard.stripe.com -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_live_...        # usar sk_test_... em desenvolvimento
# Painel: Developers -> Webhooks -> Signing secret do endpoint
STRIPE_WEBHOOK_SECRET=whsec_...
# Painel: Products -> (seu plano Pro) -> Price ID
STRIPE_PRICE_PRO=price_...
# Painel: Products -> (seu plano Enterprise) -> Price ID
STRIPE_PRICE_ENTERPRISE=price_...


# ─── Rate Limits (tunear conforme volume de uso) ──────────────────────────────
# Respostas automáticas de IA por conversa (evitar loop infinito)
AI_AUTOREPLY_MAX_PER_CONVERSATION=10
# Broadcasts: quantidade de destinatários por lote Celery
BROADCAST_BATCH_SIZE=50
# Broadcasts: mensagens por segundo (Meta limita a ~1/s por WABA)
BROADCAST_RATE_PER_SECOND=1


# =============================================================================
# REFERÊNCIA RÁPIDA — comandos úteis
# =============================================================================
#
# Gerar ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Rodar em desenvolvimento (hot-reload):
#   docker compose --profile dev up
#
# Rodar em produção:
#   docker compose up -d
#
# Ver logs dos workers:
#   docker compose logs -f worker worker_embed
#
# Monitor visual do Celery (dev):
#   docker compose --profile dev up flower
#   Acesse: http://localhost:5555
#
# Aplicar schema no Supabase:
#   Cole supabase/migrations/001_initial_schema.sql no SQL Editor do Supabase
#
# =============================================================================
