# Configuração de desenvolvimento local para Deskcomm
# Copia este arquivo para .env quando for desenvolver localmente

# ─── Ambiente ──────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# ─── Servidor ──────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
WORKERS=1

# ─── Banco de Dados (PostgreSQL local) ──────────────────────────────────────
DATABASE_URL=postgresql://deskcomm:deskcomm_dev_password@localhost:5432/deskcomm_dev

# ─── Supabase (mock local) ──────────────────────────────────────────────────
# Em desenvolvimento, apontamos para a instância local de postgres
SUPABASE_URL=http://localhost:5432
SUPABASE_KEY=dev-key-12345
SUPABASE_SERVICE_ROLE=dev-service-role

# ─── Redis (cache e sessões) ────────────────────────────────────────────────
REDIS_URL=redis://:deskcomm_dev_password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=deskcomm_dev_password

# ─── JWT (segurança) ────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-key-change-in-production-12345678901234567890
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]

# ─── Email (opcional em dev) ────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dev
SMTP_PASSWORD=dev
SMTP_FROM=dev@deskcomm.local

# ─── Super Admin (seed) ─────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=super-admin@plataforma.local
SUPER_ADMIN_PASSWORD=dev_password_change_in_production

# ─── Features (desabilitar algumas em dev) ─────────────────────────────────
ENABLE_RATE_LIMITING=false
ENABLE_CACHE=true
ENABLE_METRICS=true
